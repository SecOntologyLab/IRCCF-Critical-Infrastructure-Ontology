@prefix irccf: <https://purl.org/ircc-framework#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode irccf:GDPR_Art__22_1 ;
            sh:resultMessage "A GDPR Article 22 requirement has been asserted owl:sameAs an AI Act Article 14 requirement." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A GDPR Article 22 requirement has been asserted owl:sameAs an AI Act Article 14 requirement." ;
                    sh:select """
      PREFIX irccf: <https://purl.org/ircc-framework#>
      PREFIX owl: <http://www.w3.org/2002/07/owl#>
      SELECT $this WHERE {
        { $this owl:sameAs irccf:AIAct_Art__14_1__4 }
        UNION
        { irccf:AIAct_Art__14_1__4 owl:sameAs $this }
      }
    """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape irccf:FalseArticleEquivalenceShape ;
            sh:value irccf:GDPR_Art__22_1 ] .

