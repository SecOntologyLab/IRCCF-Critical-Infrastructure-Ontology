    irccf:technique irccf:T0835_ManipulateIOImage .

irccf:MitigationAssertion_b5e52859_8dab_4e7e_af70_bb38c6993c98 a irccf:MITREMitigationAssertion ;
    dcterms:description """Preventing screen capture on a device may require disabling various system calls supported by the operating systems (e.g., Microsoft Windows.Graphics.Capture APIs), however, these may be needed for other critical applications.
""" ;
    dcterms:modified "2026-04-29T14:23:06.174Z" ;
    irccf:mitigation irccf:MITRE_M0816 ;
    irccf:mitigationSourceRecord "relationship--b5e52859-8dab-4e7e-af70-bb38c6993c98" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0852_ScreenCapture .

irccf:MitigationAssertion_b628d878_4f35_4580_8d42_26984d13821e a irccf:MITREMitigationAssertion ;
    dcterms:description """Protocols used for control functions should provide authenticity through MAC functions or digital signatures. If not, utilize bump-in-the-wire devices or VPNs to enforce communication authenticity between devices that are not capable of supporting this (e.g., legacy controllers, RTUs).
""" ;
    dcterms:modified "2026-04-29T14:23:06.174Z" ;
    irccf:mitigation irccf:MITRE_M0802 ;
    irccf:mitigationSourceRecord "relationship--b628d878-4f35-4580-8d42-26984d13821e" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0831_ManipulationOfControl .

irccf:MitigationAssertion_b69f31c3_6c12_4b81_8e74_9c58ea635fa4 a irccf:MITREMitigationAssertion ;
    dcterms:description """Ensure that applications and devices do not store sensitive data or credentials insecurely (e.g., plaintext credentials in code, published credentials in repositories, or credentials in public cloud storage). (Citation: CISA June 2013)
""" ;
    dcterms:modified "2026-04-29T14:23:06.174Z" ;
    irccf:mitigation irccf:MITRE_M0913 ;
    irccf:mitigationSourceRecord "relationship--b69f31c3-6c12-4b81-8e74-9c58ea635fa4" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0859_ValidAccounts .

irccf:MitigationAssertion_b72b7dfd_f134_4324_84b8_52ff13fc6b5c a irccf:MITREMitigationAssertion ;
    dcterms:description """Perform audits or scans of systems, permissions, insecure software, insecure configurations, etc. to identify potential weaknesses. Perform periodic integrity checks of the device to validate the correctness of the firmware, software, programs, and configurations. Integrity checks, which typically include cryptographic hashes or digital signatures, should be compared to those obtained at known valid states, especially after events like device reboots, program downloads, or program restarts.
""" ;
    dcterms:modified "2026-04-29T14:23:06.175Z" ;
    irccf:mitigation irccf:MITRE_M0947 ;
    irccf:mitigationSourceRecord "relationship--b72b7dfd-f134-4324-84b8-52ff13fc6b5c" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0874_Hooking .

irccf:MitigationAssertion_b7f23af2_e948_4531_af56_1a1b4d03702f a irccf:MITREMitigationAssertion ;
    dcterms:description """Authenticate all access to field controllers before authorizing access to, or modification of, a device's state, logic, or programs. Centralized authentication techniques can help manage the large number of field controller accounts needed across the ICS.
""" ;
    dcterms:modified "2026-04-29T14:23:06.176Z" ;
    irccf:mitigation irccf:MITRE_M0801 ;
    irccf:mitigationSourceRecord "relationship--b7f23af2-e948-4531-af56-1a1b4d03702f" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0861_PointAndTagIdentification .

irccf:MitigationAssertion_b8c33196_8fc2_4855_b764_cd49554f0223 a irccf:MITREMitigationAssertion ;
    dcterms:description "ICS environments typically have more statically defined devices, therefore minimize the use of both IT discovery protocols (e.g., DHCP, LLDP) and discovery functions in automation protocols.(Citation: D. Parsons and D. Wylie September 2019)(Citation: Colin Gray) Examples of automation protocols with discovery capabilities include OPC UA Device Discovery(Citation: Josh Rinaldi April 2016), BACnet(Citation: Aditya K Sood July 2019), and Ethernet/IP.(Citation: Langner November 2018)" ;
    dcterms:modified "2026-04-29T14:23:06.177Z" ;
    irccf:mitigation irccf:MITRE_M0814 ;
    irccf:mitigationSourceRecord "relationship--b8c33196-8fc2-4855-b764-cd49554f0223" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0846_002_BroadcastDiscovery .

irccf:MitigationAssertion_b8ce3f0c_7c11_4846_b567_a5d4233b0e6e a irccf:MITREMitigationAssertion ;
    dcterms:description """Use host-based allowlists to prevent devices from accepting connections from unauthorized systems. For example, allowlists can be used to ensure devices can only connect with master stations or known management/engineering workstations.(Citation: Department of Homeland Security September 2016)
""" ;
    dcterms:modified "2026-04-29T14:23:06.177Z" ;
    irccf:mitigation irccf:MITRE_M0807 ;
    irccf:mitigationSourceRecord "relationship--b8ce3f0c-7c11-4846-b567-a5d4233b0e6e" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1693_001_SystemFirmware .

irccf:MitigationAssertion_b8d6e550_18fe_49ad_9964_7802bbe0cb58 a irccf:MITREMitigationAssertion ;
    dcterms:description """Take and store data backups from end user systems and critical servers. Ensure backup and storage systems are hardened and kept separate from the corporate network to prevent compromise.  Maintain and exercise incident response plans  (Citation: Department of Homeland Security October 2009), including the management of gold-copy back-up images and configurations for key systems to enable quick recovery and response from adversarial activities that impact control, view, or availability.
""" ;
    dcterms:modified "2026-04-29T14:23:06.177Z" ;
    irccf:mitigation irccf:MITRE_M0953 ;
    irccf:mitigationSourceRecord "relationship--b8d6e550-18fe-49ad-9964-7802bbe0cb58" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0826_LossOfAvailability .

irccf:MitigationAssertion_b8edcf0a_ec53_4203_b3ad_2cc734a1f1dd a irccf:MITREMitigationAssertion ;
    dcterms:description """Update software on control network assets when possible. If feasible, use modern operating systems and software to reduce exposure to known vulnerabilities.
""" ;
    dcterms:modified "2026-04-29T14:23:06.178Z" ;
    irccf:mitigation irccf:MITRE_M0951 ;
    irccf:mitigationSourceRecord "relationship--b8edcf0a-ec53-4203-b3ad-2cc734a1f1dd" ;
