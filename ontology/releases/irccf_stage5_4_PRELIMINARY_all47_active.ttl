irccf:MitigationAssertion_d2a434c7_4428_435e_ae6b_e54012f29606 a irccf:MITREMitigationAssertion ;
    dcterms:description "All field controllers should restrict the modification of programs to only certain users (e.g., engineers, field technician), preferably through implementing a role-based access mechanism." ;
    dcterms:modified "2026-04-29T14:23:06.213Z" ;
    irccf:mitigation irccf:MITRE_M0800 ;
    irccf:mitigationSourceRecord "relationship--d2a434c7-4428-435e-ae6b-e54012f29606" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0889_ModifyProgram .

irccf:MitigationAssertion_d3a24d5e_ae6e_4427_a1db_ae87b7a2b6e4 a irccf:MITREMitigationAssertion ;
    dcterms:description "Unauthorized connections can be prevented by statically defining the hosts and ports used for automation protocol connections." ;
    dcterms:modified "2026-04-29T14:23:06.215Z" ;
    irccf:mitigation irccf:MITRE_M0814 ;
    irccf:mitigationSourceRecord "relationship--d3a24d5e-ae6e-4427-a1db-ae87b7a2b6e4" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1691_BlockOperationalTechnologyMessage .

irccf:MitigationAssertion_d3c94120_e6b5_4bd2_88f0_9c73f76b0104 a irccf:MITREMitigationAssertion ;
    dcterms:description """Ensure anti-virus solution can detect malicious files that allow user execution (e.g., Microsoft Office Macros, program installers).
""" ;
    dcterms:modified "2026-04-29T14:23:06.215Z" ;
    irccf:mitigation irccf:MITRE_M0949 ;
