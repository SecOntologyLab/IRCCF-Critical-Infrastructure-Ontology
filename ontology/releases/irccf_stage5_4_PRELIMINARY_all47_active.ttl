irccf:MitigationAssertion_2b62e4c0_9267_47bd_8f4d_0394b13fb566 a irccf:MITREMitigationAssertion ;
    dcterms:description """Once an adversary has access to a remote GUI they can abuse system features, such as required HMI functions.
""" ;
    dcterms:modified "2026-04-29T14:23:05.964Z" ;
    irccf:mitigation irccf:MITRE_M0816 ;
    irccf:mitigationSourceRecord "relationship--2b62e4c0-9267-47bd-8f4d-0394b13fb566" ;
