irccf:MitigationAssertion_6c15ec9f_2b48_419c_adc1_f989833f6187 a irccf:MITREMitigationAssertion ;
    dcterms:description """Install anti-virus software on all workstation and transient assets that may have external access, such as to web, email, or remote file shares.
""" ;
    dcterms:modified "2026-04-29T14:23:06.072Z" ;
    irccf:mitigation irccf:MITRE_M0949 ;
    irccf:mitigationSourceRecord "relationship--6c15ec9f-2b48-419c-adc1-f989833f6187" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0864_TransientCyberAsset .

irccf:MitigationAssertion_6d1906b4_e815_4688_86f1_ce61d403f8c6 a irccf:MITREMitigationAssertion ;
    dcterms:description """All remote services should require strong authentication before providing user access.
""" ;
    dcterms:modified "2026-04-29T14:23:06.074Z" ;
    irccf:mitigation irccf:MITRE_M0804 ;
    irccf:mitigationSourceRecord "relationship--6d1906b4-e815-4688-86f1-ce61d403f8c6" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0886_RemoteServices .

irccf:MitigationAssertion_6f0384e6_73c8_4fc7_bc0c_0a8c2bfa473d a irccf:MITREMitigationAssertion ;
    dcterms:description """Utilize network allowlists to restrict unnecessary connections to network devices (e.g., comm servers, serial to ethernet converters) and services, especially in cases when devices have limits on the number of simultaneous sessions they support.
""" ;
    dcterms:modified "2026-04-29T14:23:06.076Z" ;
    irccf:mitigation irccf:MITRE_M0807 ;
    irccf:mitigationSourceRecord "relationship--6f0384e6-73c8-4fc7-bc0c-0a8c2bfa473d" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0802_AutomatedCollection .

irccf:MitigationAssertion_6f2c2043_6487_467a_bb49_e8cd2509ae9f a irccf:MITREMitigationAssertion ;
    dcterms:description """Regularly scan externally facing systems for vulnerabilities and establish procedures to rapidly patch systems when critical vulnerabilities are discovered through scanning and public disclosure.
""" ;
    dcterms:modified "2026-04-29T14:23:06.077Z" ;
    irccf:mitigation irccf:MITRE_M0951 ;
    irccf:mitigationSourceRecord "relationship--6f2c2043-6487-467a-bb49-e8cd2509ae9f" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0819_ExploitPublicFacingApplication .

irccf:MitigationAssertion_6f815d4c_0512_4d92_bcdf_068034233048 a irccf:MITREMitigationAssertion ;
    dcterms:description """Implement network allowlists to minimize serial comm port access to only authorized hosts, such as comm servers and RTUs.
""" ;
    dcterms:modified "2026-04-29T14:23:06.077Z" ;
    irccf:mitigation irccf:MITRE_M0807 ;
    irccf:mitigationSourceRecord "relationship--6f815d4c-0512-4d92-bcdf-068034233048" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1695_001_SerialCOM .

irccf:MitigationAssertion_703adc98_d4d1_409e_bf20_4e65921ae52f a irccf:MITREMitigationAssertion ;
    dcterms:description """Perform inline allowlisting of automation protocol commands  to prevent devices from sending unauthorized command or reporting messages. Allow/denylist techniques need to be designed with sufficient accuracy to prevent the unintended blocking of valid reporting messages.
""" ;
    dcterms:modified "2026-04-29T14:23:06.078Z" ;
    irccf:mitigation irccf:MITRE_M0937 ;
    irccf:mitigationSourceRecord "relationship--703adc98-d4d1-409e-bf20-4e65921ae52f" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1692_002_ReportingMessage .

irccf:MitigationAssertion_7041d8e5_3b74_402a_86b3_fd59def80632 a irccf:MITREMitigationAssertion ;
    dcterms:description """Hot-standbys in diverse locations can ensure continued operations if the primarily system are compromised or unavailable. At the network layer, protocols such as the Parallel Redundancy Protocol can be used to simultaneously use redundant and diverse communication over a local network. (Citation: M. Rentschler and H. Heine)
""" ;
    dcterms:modified "2026-04-29T14:23:06.078Z" ;
    irccf:mitigation irccf:MITRE_M0811 ;
    irccf:mitigationSourceRecord "relationship--7041d8e5-3b74-402a-86b3-fd59def80632" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0827_LossOfControl .

irccf:MitigationAssertion_71c9db9c_6f0c_4e33_a20a_dcd5b791a49a a irccf:MITREMitigationAssertion ;
    dcterms:description """Use user training as a way to bring awareness to common phishing and spearphishing techniques and how to raise suspicion for potentially malicious events.
""" ;
    dcterms:modified "2026-04-29T14:23:06.081Z" ;
    irccf:mitigation irccf:MITRE_M0917 ;
    irccf:mitigationSourceRecord "relationship--71c9db9c-6f0c-4e33-a20a-dcd5b791a49a" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0863_UserExecution .

irccf:MitigationAssertion_71e9230d_eec8_4ce1_bc96_9288bacc8b13 a irccf:MITREMitigationAssertion ;
    dcterms:description """To protect against AiTM, authentication mechanisms should not send credentials across the network in plaintext and should also implement mechanisms to prevent replay attacks (such as nonces or timestamps). Challenge-response based authentication techniques that do not directly send credentials over the network provide better protection from AiTM.
""" ;
    dcterms:modified "2026-04-29T14:23:06.081Z" ;
    irccf:mitigation irccf:MITRE_M0813 ;
    irccf:mitigationSourceRecord "relationship--71e9230d-eec8-4ce1-bc96-9288bacc8b13" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0830_AdversaryInTheMiddle .

irccf:MitigationAssertion_72848957_910f_4fa5_8a59_383c0a9dae62 a irccf:MITREMitigationAssertion ;
    dcterms:description """The encryption of firmware should be considered to prevent adversaries from identifying possible vulnerabilities within the firmware.
""" ;
    dcterms:modified "2026-04-29T14:23:06.082Z" ;
    irccf:mitigation irccf:MITRE_M0808 ;
    irccf:mitigationSourceRecord "relationship--72848957-910f-4fa5-8a59-383c0a9dae62" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1693_001_SystemFirmware .

irccf:MitigationAssertion_73dbe470_0d10_493b_b0ae_241da7dc0b58 a irccf:MITREMitigationAssertion ;
    dcterms:description "Use network intrusion detection/prevention systems to detect and prevent port scans." ;
    dcterms:modified "2026-04-29T14:23:06.084Z" ;
    irccf:mitigation irccf:MITRE_M0931 ;
    irccf:mitigationSourceRecord "relationship--73dbe470-0d10-493b-b0ae-241da7dc0b58" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0846_001_PortScan .

irccf:MitigationAssertion_73ed52f4_4a98_47e7_84bf_5eae555d999d a irccf:MITREMitigationAssertion ;
    dcterms:description """Utilize network allowlists to restrict unnecessary connections to network devices (e.g., comm servers, serial to ethernet converters) and services, especially in cases when devices have limits on the number of simultaneous sessions they support.
""" ;
    dcterms:modified "2026-04-29T14:23:06.084Z" ;
    irccf:mitigation irccf:MITRE_M0807 ;
    irccf:mitigationSourceRecord "relationship--73ed52f4-4a98-47e7-84bf-5eae555d999d" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1691_002_ReportingMessage .

irccf:MitigationAssertion_7411b05d_209a_4907_83ce_00ab1538fbac a irccf:MITREMitigationAssertion ;
    dcterms:description """Network intrusion detection and prevention systems that use network signatures to identify traffic for specific adversary malware can be used to mitigate activity at the network level. Signatures are often for unique indicators within protocols and may be based on the specific C2 protocol used by a particular adversary or tool and will likely be different across various malware families and versions. Adversaries will likely change tool C2 signatures over time or construct protocols in such a way as to avoid detection by common defensive tools. (Citation: Gardiner, J.,  Cova, M., Nagaraja, S February 2014)
""" ;
    dcterms:modified "2026-04-29T14:23:06.084Z" ;
    irccf:mitigation irccf:MITRE_M0931 ;
    irccf:mitigationSourceRecord "relationship--7411b05d-209a-4907-83ce-00ab1538fbac" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0884_ConnectionProxy .

irccf:MitigationAssertion_74ec9ce5_3155_488c_ae56_570c47a1d207 a irccf:MITREMitigationAssertion ;
    dcterms:description """ICS environments typically have more statically defined devices, therefore minimize the use of both IT discovery protocols (e.g., DHCP, LLDP) and discovery functions in automation protocols. (Citation: D. Parsons and D. Wylie September 2019) (Citation: Colin Gray) Examples of automation protocols with discovery capabilities include OPC UA Device Discovery  (Citation: Josh Rinaldi April 2016), BACnet  (Citation: Aditya K Sood July 2019), and Ethernet/IP. (Citation: Langner November 2018)
""" ;
    dcterms:modified "2026-04-29T14:23:06.085Z" ;
    irccf:mitigation irccf:MITRE_M0814 ;
    irccf:mitigationSourceRecord "relationship--74ec9ce5-3155-488c-ae56-570c47a1d207" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0888_RemoteSystemInformationDiscovery .

irccf:MitigationAssertion_75366cbf_e45f_4cfd_9e76_5af4dfe10766 a irccf:MITREMitigationAssertion ;
    dcterms:description """Execution prevention may block malicious software from accessing protected resources through the command line interface.
""" ;
    dcterms:modified "2026-04-29T14:23:06.085Z" ;
    irccf:mitigation irccf:MITRE_M0938 ;
    irccf:mitigationSourceRecord "relationship--75366cbf-e45f-4cfd-9e76-5af4dfe10766" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0807_CommandLineInterface .

irccf:MitigationAssertion_754521fc_4306_4daa_831b_6b6fb45847e2 a irccf:MITREMitigationAssertion ;
    dcterms:description """All APIs used to perform execution, especially those hosted on embedded controllers (e.g., PLCs), should provide adequate authorization enforcement of user access. Minimize user's access to only required API calls. (Citation: MITRE June 2020)
""" ;
    dcterms:modified "2026-04-29T14:23:06.085Z" ;
    irccf:mitigation irccf:MITRE_M0800 ;
    irccf:mitigationSourceRecord "relationship--754521fc-4306-4daa-831b-6b6fb45847e2" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0871_ExecutionThroughAPI .

irccf:MitigationAssertion_758d5818_f919_4a6b_9dc2_a212595a11bd a irccf:MITREMitigationAssertion ;
    dcterms:description """Authenticate connections from software and devices to prevent unauthorized systems from accessing protected management functions.
""" ;
    dcterms:modified "2026-04-29T14:23:06.086Z" ;
    irccf:mitigation irccf:MITRE_M0813 ;
    irccf:mitigationSourceRecord "relationship--758d5818-f919-4a6b-9dc2-a212595a11bd" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0800_ActivateFirmwareUpdateMode .

irccf:MitigationAssertion_79324bdd_cdab_4d0a_af60_af1047c1d117 a irccf:MITREMitigationAssertion ;
    dcterms:description "All field controllers should require users to authenticate for all remote or local management sessions. The authentication mechanisms should also support [Account Use Policies](https://attack.mitre.org/mitigations/M0936), [Password Policies](https://attack.mitre.org/mitigations/M0927), and [User Account Management](https://attack.mitre.org/mitigations/M0918)." ;
    dcterms:modified "2026-04-29T14:23:06.091Z" ;
    irccf:mitigation irccf:MITRE_M0804 ;
    irccf:mitigationSourceRecord "relationship--79324bdd-cdab-4d0a-af60-af1047c1d117" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0861_PointAndTagIdentification .

irccf:MitigationAssertion_798919d3_df8b_463f_b2be_4c1aa8089384 a irccf:MITREMitigationAssertion ;
    dcterms:description """Segment and control software movement between business and OT environments by way of one directional DMZs. Web access should be restricted from the OT environment. Engineering workstations, including transient cyber assets (TCAs) should have minimal connectivity to external networks, including Internet and email, further limit the extent to which these devices are dual-homed to multiple networks. (Citation: North America Transmission Forum December 2019)
""" ;
    dcterms:modified "2026-04-29T14:23:06.091Z" ;
    irccf:mitigation irccf:MITRE_M0930 ;
    irccf:mitigationSourceRecord "relationship--798919d3-df8b-463f-b2be-4c1aa8089384" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0864_TransientCyberAsset .

irccf:MitigationAssertion_7bfaf0ff_6d88_460f_aa32_3fb0267b4f20 a irccf:MITREMitigationAssertion ;
    dcterms:description """Traffic to known anonymity networks and C2 infrastructure can be blocked through the use of network allow and block lists. It should be noted that this kind of blocking may be circumvented by other techniques likeDomain Fronting.
""" ;
    dcterms:modified "2026-04-29T14:23:06.095Z" ;
    irccf:mitigation irccf:MITRE_M0937 ;
    irccf:mitigationSourceRecord "relationship--7bfaf0ff-6d88-460f-aa32-3fb0267b4f20" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0884_ConnectionProxy .

irccf:MitigationAssertion_7c2edd6c_5189_4ba9_af3d_bdaff4a699ca a irccf:MITREMitigationAssertion ;
    dcterms:description """Consider removing or restricting features that are unnecessary to an asset's intended function within the control environment.
""" ;
    dcterms:modified "2026-04-29T14:23:06.095Z" ;
    irccf:mitigation irccf:MITRE_M0942 ;
    irccf:mitigationSourceRecord "relationship--7c2edd6c-5189-4ba9-af3d-bdaff4a699ca" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0807_CommandLineInterface .

irccf:MitigationAssertion_7d5759cd_890e_4ec5_b92b_aba225d52960 a irccf:MITREMitigationAssertion ;
    dcterms:description """Authenticate connections from software and devices to prevent unauthorized systems from accessing protected management functions.
""" ;
