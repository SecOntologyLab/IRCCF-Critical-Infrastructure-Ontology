irccf:MitigationAssertion_a8f136ed_4ab7_4dbc_ba22_db57ace5ed6e a irccf:MITREMitigationAssertion ;
    dcterms:description """All devices or systems changes, including all administrative functions, should require authentication. Consider using access management technologies to enforce authorization on all management interface access attempts, especially when the device does not inherently provide strong authentication and authorization functions.
""" ;
    dcterms:modified "2026-04-29T14:23:06.155Z" ;
    irccf:mitigation irccf:MITRE_M0801 ;
    irccf:mitigationSourceRecord "relationship--a8f136ed-4ab7-4dbc-ba22-db57ace5ed6e" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1693_002_ModuleFirmware .

irccf:MitigationAssertion_a91002fe_21b2_4417_9c23_af712a7a035c a irccf:MITREMitigationAssertion ;
    dcterms:description """Utilize code signatures to verify the integrity and authenticity of programs installed on safety or control assets.
""" ;
    dcterms:modified "2026-04-29T14:23:06.155Z" ;
    irccf:mitigation irccf:MITRE_M0945 ;
    irccf:mitigationSourceRecord "relationship--a91002fe-21b2-4417-9c23-af712a7a035c" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0889_ModifyProgram .

