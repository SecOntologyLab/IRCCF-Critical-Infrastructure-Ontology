irccf:MitigationAssertion_5804ae3d_0daf_47a5_b026_d42878f55803 a irccf:MITREMitigationAssertion ;
    dcterms:description """This type of attack technique cannot be easily mitigated with preventive controls since it is based on the abuse of system features.
""" ;
