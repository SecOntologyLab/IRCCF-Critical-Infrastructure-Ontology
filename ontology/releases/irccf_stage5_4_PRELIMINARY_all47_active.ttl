irccf:MitigationAssertion_42ab7d24_8286_4a7a_8cd7_02e54a80e13f a irccf:MITREMitigationAssertion ;
    dcterms:description """Ensure permissions restrict project file access to only engineer and technician user groups and accounts.
""" ;
    dcterms:modified "2026-04-29T14:23:06.016Z" ;
    irccf:mitigation irccf:MITRE_M0922 ;
    irccf:mitigationSourceRecord "relationship--42ab7d24-8286-4a7a-8cd7-02e54a80e13f" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0873_ProjectFileInfection .

irccf:MitigationAssertion_4369da69_bb09_4cc8_8600_081a450f50e0 a irccf:MITREMitigationAssertion ;
    dcterms:description """Ensure that unnecessary ports and services are closed to prevent risk of discovery and potential exploitation.
""" ;
    dcterms:modified "2026-04-29T14:23:06.017Z" ;
    irccf:mitigation irccf:MITRE_M0942 ;
    irccf:mitigationSourceRecord "relationship--4369da69-bb09-4cc8-8600-081a450f50e0" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0866_ExploitationOfRemoteServices .

irccf:MitigationAssertion_446c95ea_5178_4ae9_8f92_cb20dd50f7de a irccf:MITREMitigationAssertion ;
    dcterms:description """Minimize the exposure of API calls that allow the execution of code.
""" ;
    dcterms:modified "2026-04-29T14:23:06.019Z" ;
    irccf:mitigation irccf:MITRE_M0938 ;
    irccf:mitigationSourceRecord "relationship--446c95ea-5178-4ae9-8f92-cb20dd50f7de" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0834_NativeAPI .

irccf:MitigationAssertion_44c857cf_7a4e_405a_87ca_7f6d79000589 a irccf:MITREMitigationAssertion ;
    dcterms:description """Take and store data backups from end user systems and critical servers. Ensure backup and storage systems are hardened and kept separate from the corporate network to prevent compromise.  Maintain and exercise incident response plans (Citation: Department of Homeland Security October 2009), including the management of gold-copy back-up images and configurations for key systems to enable quick recovery and response from adversarial activities that impact control, view, or availability.
""" ;
    dcterms:modified "2026-04-29T14:23:06.019Z" ;
    irccf:mitigation irccf:MITRE_M0953 ;
    irccf:mitigationSourceRecord "relationship--44c857cf-7a4e-405a-87ca-7f6d79000589" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0813_DenialOfControl .

irccf:MitigationAssertion_45ee1822_71e4_4d92_976d_306561b70555 a irccf:MITREMitigationAssertion ;
    dcterms:description """Segment operational network and systems to restrict access to critical system functions to predetermined management systems. (Citation: Department of Homeland Security September 2016)
""" ;
    dcterms:modified "2026-04-29T14:23:06.021Z" ;
    irccf:mitigation irccf:MITRE_M0930 ;
    irccf:mitigationSourceRecord "relationship--45ee1822-71e4-4d92-976d-306561b70555" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0816_DeviceRestartShutdown .

irccf:MitigationAssertion_461e81a2_c7ad_499e_908d_05ef2f7bd9cd a irccf:MITREMitigationAssertion ;
    dcterms:description """Utilize network allowlists to restrict unnecessary connections to network devices (e.g., comm servers, serial to ethernet converters) and services, especially in cases when devices have limits on the number of simultaneous sessions they support.
""" ;
    dcterms:modified "2026-04-29T14:23:06.021Z" ;
    irccf:mitigation irccf:MITRE_M0807 ;
    irccf:mitigationSourceRecord "relationship--461e81a2-c7ad-499e-908d-05ef2f7bd9cd" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0806_BruteForceIO .

irccf:MitigationAssertion_4653847b_c089_4435_9159_6f76353833f7 a irccf:MITREMitigationAssertion ;
    dcterms:description "All field controllers should restrict the modification of controller tasks to only certain users (e.g., engineers, field technician), preferably through implementing a role-based access mechanism." ;
    dcterms:modified "2026-04-29T14:23:06.021Z" ;
    irccf:mitigation irccf:MITRE_M0800 ;
    irccf:mitigationSourceRecord "relationship--4653847b-c089-4435-9159-6f76353833f7" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0821_ModifyControllerTasking .

irccf:MitigationAssertion_47f15a06_8675_4698_833d_bd141ed9e755 a irccf:MITREMitigationAssertion ;
    dcterms:description """Security applications that look for behavior used during exploitation such as Windows Defender Exploit Guard (WDEG) and the Enhanced Mitigation Experience Toolkit (EMET) can be used to mitigate some exploitation behavior. (Citation: Microsoft Security Response Center August 2017) Control flow integrity checking is another way to potentially identify and stop a software exploit from occurring. (Citation: Wikipedia) Many of these protections depend on the architecture and target application binary for compatibility and may not work for all software or services targeted.
""" ;
    dcterms:modified "2026-04-29T14:23:06.023Z" ;
    irccf:mitigation irccf:MITRE_M0950 ;
    irccf:mitigationSourceRecord "relationship--47f15a06-8675-4698-833d-bd141ed9e755" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0866_ExploitationOfRemoteServices .

irccf:MitigationAssertion_491455dc_f7c8_4e12_811b_b8c5c041b4c3 a irccf:MITREMitigationAssertion ;
    dcterms:description """Protocols used for control functions should provide authenticity through MAC functions or digital signatures. If not, utilize bump-in-the-wire devices or VPNs to enforce communication authenticity between devices that are not capable of supporting this (e.g., legacy controllers, RTUs).
""" ;
    dcterms:modified "2026-04-29T14:23:06.025Z" ;
    irccf:mitigation irccf:MITRE_M0802 ;
    irccf:mitigationSourceRecord "relationship--491455dc-f7c8-4e12-811b-b8c5c041b4c3" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0816_DeviceRestartShutdown .

irccf:MitigationAssertion_4966e63c_ca05_466d_91f9_41d799a54471 a irccf:MITREMitigationAssertion ;
    dcterms:description """Provide privileges corresponding to the restriction of a GUI session to control system operations (examples include HMI read-only vs. read-write modes). Ensure local users, such as operators and engineers, are giving prioritization over remote sessions and have the authority to regain control over a remote session if needed. Prevent remote access sessions (e.g., RDP, VNC) from taking over local sessions, especially those used for ICS control, especially HMIs.
""" ;
    dcterms:modified "2026-04-29T14:23:06.025Z" ;
    irccf:mitigation irccf:MITRE_M0800 ;
    irccf:mitigationSourceRecord "relationship--4966e63c-ca05-466d-91f9-41d799a54471" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0886_RemoteServices .

irccf:MitigationAssertion_49aebf0c_e231_4cbb_84a2_97c9a6d11654 a irccf:MITREMitigationAssertion ;
    dcterms:description "Ensure proper network segmentation is followed to protect critical systems and devices." ;
    dcterms:modified "2026-04-29T14:23:06.026Z" ;
    irccf:mitigation irccf:MITRE_M0930 ;
    irccf:mitigationSourceRecord "relationship--49aebf0c-e231-4cbb-84a2-97c9a6d11654" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0846_001_PortScan .

irccf:MitigationAssertion_49d38b21_5ce5_48d9_a356_639fc6c7a53d a irccf:MITREMitigationAssertion ;
    dcterms:description "All field controllers should require users to authenticate for all remote or local management sessions. The authentication mechanisms should also support [Account Use Policies](https://attack.mitre.org/mitigations/M0936), [Password Policies](https://attack.mitre.org/mitigations/M0927), and [User Account Management](https://attack.mitre.org/mitigations/M0918)." ;
    dcterms:modified "2026-04-29T14:23:06.026Z" ;
    irccf:mitigation irccf:MITRE_M0804 ;
    irccf:mitigationSourceRecord "relationship--49d38b21-5ce5-48d9-a356-639fc6c7a53d" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0868_DetectOperatingMode .

irccf:MitigationAssertion_4b44a657_11cc_45bc_b096_f32e58a70036 a irccf:MITREMitigationAssertion ;
    dcterms:description """Restrict unauthorized devices from accessing serial comm ports.
""" ;
    dcterms:modified "2026-04-29T14:23:06.028Z" ;
    irccf:mitigation irccf:MITRE_M0930 ;
    irccf:mitigationSourceRecord "relationship--4b44a657-11cc-45bc-b096-f32e58a70036" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1695_001_SerialCOM .

irccf:MitigationAssertion_4e7ec200_9a1b_46d4_9383_738903fec554 a irccf:MITREMitigationAssertion ;
    dcterms:description "Protocols used for device management should authenticate all network messages to prevent unauthorized system changes." ;
    dcterms:modified "2026-04-29T14:23:06.032Z" ;
    irccf:mitigation irccf:MITRE_M0802 ;
    irccf:mitigationSourceRecord "relationship--4e7ec200-9a1b-46d4-9383-738903fec554" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0843_002_OnlineEdit .

irccf:MitigationAssertion_502a0b7e_048a_468a_b888_e91fde47c6eb a irccf:MITREMitigationAssertion ;
    dcterms:description """Segment and control software movement between business and OT environments by way of one directional DMZs. Web access should be restricted from the OT environment. Engineering workstations, including transient cyber assets (TCAs) should have minimal connectivity to external networks, including Internet and email, further limit the extent to which these devices are dual-homed to multiple networks. (Citation: North America Transmission Forum December 2019)
""" ;
    dcterms:modified "2026-04-29T14:23:06.035Z" ;
    irccf:mitigation irccf:MITRE_M0930 ;
    irccf:mitigationSourceRecord "relationship--502a0b7e-048a-468a-b888-e91fde47c6eb" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0886_RemoteServices .

irccf:MitigationAssertion_5041e17d_6349_4589_8c61_7b43964b5f9b a irccf:MITREMitigationAssertion ;
    dcterms:description """Integrity checking of transient assets can include performing the validation of the booted operating system and programs using TPM-based technologies, such as Secure Boot and Trusted Boot. (Citation: Emerson Exchange) It can also include verifying filesystem changes, such as programs and configuration files stored on the system, executing processes, libraries, accounts, and open ports.   (Citation: National Security Agency February 2016)
""" ;
    dcterms:modified "2026-04-29T14:23:06.035Z" ;
    irccf:mitigation irccf:MITRE_M0947 ;
    irccf:mitigationSourceRecord "relationship--5041e17d-6349-4589-8c61-7b43964b5f9b" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0864_TransientCyberAsset .

irccf:MitigationAssertion_50a2b289_7bce_405d_8515_c2b5424cce5c a irccf:MITREMitigationAssertion ;
    dcterms:description """Information which is sensitive to the operation and architecture of the process environment may be encrypted to ensure confidentiality and restrict access to only those who need to know. (Citation: Keith Stouffer May 2015) (Citation: National Institute of Standards and Technology April 2013)
""" ;
    dcterms:modified "2026-04-29T14:23:06.035Z" ;
    irccf:mitigation irccf:MITRE_M0941 ;
    irccf:mitigationSourceRecord "relationship--50a2b289-7bce-405d-8515-c2b5424cce5c" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0811_DataFromInformationRepositories .

irccf:MitigationAssertion_50c2224e_7592_4400_afbb_6434e025bfd8 a irccf:MITREMitigationAssertion ;
    dcterms:description "Ensure embedded controls and network devices are protected through access management, as these devices often have unknown hardcoded accounts which could be used to gain unauthorized access." ;
    dcterms:modified "2026-04-29T14:23:06.036Z" ;
    irccf:mitigation irccf:MITRE_M0801 ;
    irccf:mitigationSourceRecord "relationship--50c2224e-7592-4400-afbb-6434e025bfd8" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1694_002_HardcodedCredentials .

irccf:MitigationAssertion_520aad6a_2483_45bc_a172_2417137f6ca0 a irccf:MITREMitigationAssertion ;
    dcterms:description """Utilize out-of-band communication to validate the integrity of data from the primary channel.
""" ;
    dcterms:modified "2026-04-29T14:23:06.037Z" ;
    irccf:mitigation irccf:MITRE_M0810 ;
    irccf:mitigationSourceRecord "relationship--520aad6a-2483-45bc-a172-2417137f6ca0" ;
