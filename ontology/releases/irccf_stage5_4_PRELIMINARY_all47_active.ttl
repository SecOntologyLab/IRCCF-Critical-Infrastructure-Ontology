        irccf:GDPR_Art__5_1_b,
        irccf:GDPR_Art__5_1_c,
        irccf:GDPR_Art__5_1_f .

irccf:Govern a irccf:FrameworkFunction ;
    rdfs:label "Govern" ;
    irccf:belongsToFramework irccf:NIST_CSF_2_0 .

irccf:InputValidationControl a irccf:SecurityControl ;
    rdfs:label "Input validation control (SR 3.5)" ;
    irccf:belongsToStandard irccf:IEC_62443_3_3 ;
    irccf:description "Input validation to prevent injection and manipulation." ;
    irccf:mitigates irccf:T0819_ExploitPublicFacingApplication,
        irccf:T0820_ExploitationForEvasion,
        irccf:T0853_Scripting .

