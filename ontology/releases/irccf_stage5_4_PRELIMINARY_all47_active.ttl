irccf:MitigationAssertion_ae20022f_25b5_4eff_8775_53f1e0ad91b8 a irccf:MITREMitigationAssertion ;
    dcterms:description """Unauthorized connections can be prevented by statically defining the hosts and ports used for automation protocol connections.
""" ;
    dcterms:modified "2026-04-29T14:23:06.162Z" ;
    irccf:mitigation irccf:MITRE_M0814 ;
    irccf:mitigationSourceRecord "relationship--ae20022f-25b5-4eff-8775-53f1e0ad91b8" ;
    irccf:mitreDataVersion "ICS v19.2" ;
