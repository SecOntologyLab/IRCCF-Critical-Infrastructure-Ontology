irccf:MITRE_M0805 a irccf:MITREMitigation ;
    rdfs:label "Mechanical Protection Layers" ;
    dcterms:description "Utilize a layered protection design based on physical or mechanical protection systems to prevent damage to property, equipment, human safety, or the environment. Examples include interlocks, rupture disk, release values, etc. (Citation: A G Foord, W G Gulland, C R Howard, T Kellacher, W H Smith 2004) " ;
    dcterms:source <https://attack.mitre.org/mitigations/M0805/> ;
    irccf:hasMitigationAssertion irccf:MitigationAssertion_242b5a0d_e4e8_4ceb_a975_cf8efd64e981,
        irccf:MitigationAssertion_e607bb66_e53f_4684_b3f1_36a997e27d01 ;
    irccf:mitigatesTechnique irccf:T0879_DamageToProperty,
        irccf:T0880_LossOfSafety ;
    irccf:mitreAttackID "M0805" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:mitreObjectVersion "1.0" ;
    irccf:mitreSTIXID "course-of-action--8bc4a54e-810c-4600-8b6c-08fa8413a401" .

irccf:MITRE_M0812 a irccf:MITREMitigation ;
    rdfs:label "Safety Instrumented Systems" ;
    dcterms:description "Utilize Safety Instrumented Systems (SIS) to provide an additional layer of protection to hazard scenarios that may cause property damage. A SIS will typically include sensors, logic solvers, and a final control element that can be used to automatically respond to an hazardous condition  (Citation: A G Foord, W G Gulland, C R Howard, T Kellacher, W H Smith 2004) . Ensure that all SISs are segmented from operational networks to prevent them from being targeted by additional adversarial behavior." ;
    dcterms:source <https://attack.mitre.org/mitigations/M0812/> ;
    irccf:hasMitigationAssertion irccf:MitigationAssertion_0ffdee1a_1e83_4506_aba2_38c55812abb3,
        irccf:MitigationAssertion_d1d98f8c_aea2_4f06_9b0d_c543ed42c6a4 ;
    irccf:mitigatesTechnique irccf:T0879_DamageToProperty,
        irccf:T0880_LossOfSafety ;
    irccf:mitreAttackID "M0812" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:mitreObjectVersion "1.0" ;
    irccf:mitreSTIXID "course-of-action--da44255d-85c5-492c-baf3-ee823d44f848" .

irccf:MITRE_M0815 a irccf:MITREMitigation ;
    rdfs:label "Watchdog Timers" ;
    dcterms:description "Utilize watchdog timers to ensure devices can quickly detect whether a system is unresponsive." ;
    dcterms:source <https://attack.mitre.org/mitigations/M0815/> ;
    irccf:hasMitigationAssertion irccf:MitigationAssertion_5d0a7979_0420_4fd1_b5ad_cb5565cbdf9d ;
    irccf:hasStandardsReference irccf:StandardsReference_M0815_1 ;
    irccf:mitigatesTechnique irccf:T0814_DenialOfService ;
    irccf:mitreAttackID "M0815" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:mitreObjectVersion "1.0" ;
    irccf:mitreSTIXID "course-of-action--98aa0d61-fc9d-4b2d-8f18-b25d03549f53" ;
    irccf:referencesStandardsControl irccf:Standards_9150273d8bf5b81422ea .

