irccf:MitigationAssertion_d8f45959_e0fc_4b4f_a074_a3acea926300 a irccf:MITREMitigationAssertion ;
    dcterms:description """Consider the disabling of features such as AutoRun.
""" ;
    dcterms:modified "2026-04-29T14:23:06.221Z" ;
    irccf:mitigation irccf:MITRE_M0942 ;
    irccf:mitigationSourceRecord "relationship--d8f45959-e0fc-4b4f-a074-a3acea926300" ;
    irccf:mitreDataVersion "ICS v19.2" ;
