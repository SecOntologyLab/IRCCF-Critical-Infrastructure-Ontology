irccf:MitigationAssertion_107d9a23_991b_44f5_97f6_7f6983c7013a a irccf:MITREMitigationAssertion ;
    dcterms:description """Authenticate connections from software and devices to prevent unauthorized systems from accessing protected management functions.
""" ;
    dcterms:modified "2026-04-29T14:23:05.926Z" ;
    irccf:mitigation irccf:MITRE_M0813 ;
    irccf:mitigationSourceRecord "relationship--107d9a23-991b-44f5-97f6-7f6983c7013a" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0868_DetectOperatingMode .

irccf:MitigationAssertion_111f437a_c67d_40e4_9515_7e9b22e65eff a irccf:MITREMitigationAssertion ;
    dcterms:description """Audit domain and local accounts and their permission levels routinely to look for situations that could allow an adversary to gain system wide access with stolen privileged account credentials. (Citation: Microsoft May 2017) (Citation: Microsoft August 2018)These audits should also identify if default accounts have been enabled, or if new local accounts are created that have not be authorized. Follow best practices for design and administration of an enterprise network to limit privileged account use across administrative tiers. (Citation: Microsoft February 2019)
""" ;
    dcterms:modified "2026-04-29T14:23:05.927Z" ;
    irccf:mitigation irccf:MITRE_M0926 ;
    irccf:mitigationSourceRecord "relationship--111f437a-c67d-40e4-9515-7e9b22e65eff" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0859_ValidAccounts .

irccf:MitigationAssertion_12a6c5bc_c685_4249_b8c6_e6d49aa2b9ed a irccf:MITREMitigationAssertion ;
    dcterms:description """Protocols used for device management should authenticate all network messages to prevent unauthorized system changes.
""" ;
    dcterms:modified "2026-04-29T14:23:05.929Z" ;
    irccf:mitigation irccf:MITRE_M0802 ;
    irccf:mitigationSourceRecord "relationship--12a6c5bc-c685-4249-b8c6-e6d49aa2b9ed" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0858_ChangeOperatingMode .

irccf:MitigationAssertion_137ce4a2_be4c_4eb7_b92c_d686fa2a1044 a irccf:MITREMitigationAssertion ;
    dcterms:description "Utilize code signatures to verify the integrity and authenticity of programs downloaded to the device." ;
    dcterms:modified "2026-04-29T14:23:05.930Z" ;
    irccf:mitigation irccf:MITRE_M0945 ;
    irccf:mitigationSourceRecord "relationship--137ce4a2-be4c-4eb7-b92c-d686fa2a1044" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0843_001_DownloadAll .

irccf:MitigationAssertion_16b92a53_7334_42b1_bc55_dcd4907fdd9f a irccf:MITREMitigationAssertion ;
    dcterms:description """Segment operational network and systems to restrict access to critical system functions to predetermined management systems.(Citation: Department of Homeland Security September 2016)
""" ;
    dcterms:modified "2026-04-29T14:23:05.935Z" ;
    irccf:mitigation irccf:MITRE_M0930 ;
    irccf:mitigationSourceRecord "relationship--16b92a53-7334-42b1-bc55-dcd4907fdd9f" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1693_002_ModuleFirmware .

irccf:MitigationAssertion_17925772_5935_4f50_bf0e_abb5e0bad6b3 a irccf:MITREMitigationAssertion ;
    dcterms:description "ICS environments typically have more statically defined devices, therefore minimize the use of both IT discovery protocols (e.g., DHCP, LLDP) and discovery functions in automation protocols.(Citation: D. Parsons and D. Wylie September 2019)(Citation: Colin Gray) Examples of automation protocols with discovery capabilities include OPC UA Device Discovery (Citation: Josh Rinaldi April 2016), BACnet(Citation: Aditya K Sood July 2019), and Ethernet/IP.(Citation: Langner November 2018)" ;
    dcterms:modified "2026-04-29T14:23:05.936Z" ;
    irccf:mitigation irccf:MITRE_M0814 ;
    irccf:mitigationSourceRecord "relationship--17925772-5935-4f50-bf0e-abb5e0bad6b3" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0846_003_MulticastDiscovery .

irccf:MitigationAssertion_17ae41a5_cb45_4935_bec1_ea0c8bfb2f34 a irccf:MITREMitigationAssertion ;
    dcterms:description """This technique may not be effectively mitigated against, consider controls for assets and processes that lead to the use of this technique.
""" ;
    dcterms:modified "2026-04-29T14:23:05.937Z" ;
    irccf:mitigation irccf:MITRE_M0816 ;
    irccf:mitigationSourceRecord "relationship--17ae41a5-cb45-4935-bec1-ea0c8bfb2f34" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0877_IOImage .

irccf:MitigationAssertion_18ef2d69_d11a_4d31_a803_da989c4073f7 a irccf:MITREMitigationAssertion ;
    dcterms:description """Provide operators with redundant, out-of-band communication to support monitoring and control of the operational processes, especially when recovering from a network outage  (Citation: National Institute of Standards and Technology April 2013). Out-of-band communication should utilize diverse systems and technologies to minimize common failure modes and vulnerabilities within the communications infrastructure. For example, wireless networks (e.g., 3G, 4G) can be used to provide diverse and redundant delivery of data.
""" ;
    dcterms:modified "2026-04-29T14:23:05.938Z" ;
    irccf:mitigation irccf:MITRE_M0810 ;
    irccf:mitigationSourceRecord "relationship--18ef2d69-d11a-4d31-a803-da989c4073f7" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0815_DenialOfView .

irccf:MitigationAssertion_19ab6776_42de_48af_975a_568d31a3bb66 a irccf:MITREMitigationAssertion ;
    dcterms:description """Segment operational network and systems to restrict access to critical system functions to predetermined management systems. (Citation: Department of Homeland Security September 2016) (Citation: N/A)
""" ;
    dcterms:modified "2026-04-29T14:23:05.940Z" ;
    irccf:mitigation irccf:MITRE_M0930 ;
    irccf:mitigationSourceRecord "relationship--19ab6776-42de-48af-975a-568d31a3bb66" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0838_ModifyAlarmSettings .

irccf:MitigationAssertion_1a40cec9_47c3_404e_b039_b7ae83ffaf68 a irccf:MITREMitigationAssertion ;
    dcterms:description """Ensure all browsers and plugins are kept updated to help prevent the exploit phase of this technique. Use modern browsers with security features enabled.
""" ;
    dcterms:modified "2026-04-29T14:23:05.940Z" ;
    irccf:mitigation irccf:MITRE_M0951 ;
    irccf:mitigationSourceRecord "relationship--1a40cec9-47c3-404e-b039-b7ae83ffaf68" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0817_DriveByCompromise .

irccf:MitigationAssertion_1aa02c37_973e_46bd_ab45_609463e514e9 a irccf:MITREMitigationAssertion ;
    dcterms:description """If a link is being visited by a user, block unknown or unused files in transit by default that should not be downloaded or by policy from suspicious sites as a best practice to prevent some vectors, such as .scr, .exe, .pif, .cpl, etc. Some download scanning devices can open and analyze compressed and encrypted formats, such as zip and rar that may be used to conceal malicious files.
""" ;
    dcterms:modified "2026-04-29T14:23:05.941Z" ;
    irccf:mitigation irccf:MITRE_M0921 ;
    irccf:mitigationSourceRecord "relationship--1aa02c37-973e-46bd-ab45-609463e514e9" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0863_UserExecution .

irccf:MitigationAssertion_1c3d966a_5995_48ed_919d_25b972010fe9 a irccf:MITREMitigationAssertion ;
    dcterms:description """Provide the ability to verify the integrity of programs downloaded on a controller. While techniques like CRCs and checksums are commonly used, they are not cryptographically secure and can be vulnerable to collisions. Preferably cryptographic hash functions (e.g., SHA-2, SHA-3) should be used.(Citation: IEC February 2019)
""" ;
    dcterms:modified "2026-04-29T14:23:05.943Z" ;
    irccf:mitigation irccf:MITRE_M0947 ;
    irccf:mitigationSourceRecord "relationship--1c3d966a-5995-48ed-919d-25b972010fe9" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0843_ProgramDownload .

irccf:MitigationAssertion_1ddb73e6_b7a8_4f4d_bf8b_f9de3a5ef52a a irccf:MITREMitigationAssertion ;
    dcterms:description "Provide the ability to verify the integrity of programs downloaded on a controller. While techniques like CRCs and checksums are commonly used, they are not cryptographically secure and can be vulnerable to collisions. Preferably cryptographic hash functions (e.g., SHA-2, SHA-3) should be used.(Citation: IEC February 2019)" ;
    dcterms:modified "2026-04-29T14:23:05.945Z" ;
