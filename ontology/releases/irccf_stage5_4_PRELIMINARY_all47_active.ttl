irccf:MitigationAssertion_d462143c_69d1_44c9_b657_b64deb12eab8 a irccf:MITREMitigationAssertion ;
    dcterms:description "The encryption of firmware should be considered to prevent adversaries from identifying possible vulnerabilities within the firmware." ;
    dcterms:modified "2026-04-29T14:23:06.216Z" ;
    irccf:mitigation irccf:MITRE_M0941 ;
    irccf:mitigationSourceRecord "relationship--d462143c-69d1-44c9-b657-b64deb12eab8" ;
