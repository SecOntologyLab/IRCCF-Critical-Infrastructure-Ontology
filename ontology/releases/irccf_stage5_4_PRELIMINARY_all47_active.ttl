irccf:MitigationAssertion_2c6c4752_536e_4b96_86d7_7efe88350082 a irccf:MITREMitigationAssertion ;
    dcterms:description """Provide an alternative method for sending critical command messages to outstations, this could include using radio/cell communication to send messages to a field technician that physically performs the control function.
""" ;
    dcterms:modified "2026-04-29T14:23:05.965Z" ;
    irccf:mitigation irccf:MITRE_M0810 ;
    irccf:mitigationSourceRecord "relationship--2c6c4752-536e-4b96-86d7-7efe88350082" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1691_001_CommandMessage .

irccf:MitigationAssertion_2cd79563_0f5a_44a1_9be4_6dc330855d64 a irccf:MITREMitigationAssertion ;
    dcterms:description """Use host-based allowlists to prevent devices from accepting connections from unauthorized systems. For example, allowlists can be used to ensure devices can only connect with master stations or known management/engineering workstations. (Citation: Department of Homeland Security September 2016)
""" ;
    dcterms:modified "2026-04-29T14:23:05.965Z" ;
    irccf:mitigation irccf:MITRE_M0807 ;
    irccf:mitigationSourceRecord "relationship--2cd79563-0f5a-44a1-9be4-6dc330855d64" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0838_ModifyAlarmSettings .

irccf:MitigationAssertion_2d621264_4a6d_4bc7_abaf_89a89c2ef813 a irccf:MITREMitigationAssertion ;
    dcterms:description "Devices should verify that firmware has been properly signed by the vendor before allowing installation." ;
    dcterms:modified "2026-04-29T14:23:05.966Z" ;
    irccf:mitigation irccf:MITRE_M0945 ;
    irccf:mitigationSourceRecord "relationship--2d621264-4a6d-4bc7-abaf-89a89c2ef813" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1693_ModifyFirmware .

irccf:MitigationAssertion_2daeeaaa_5b4b_4bb7_a94d_78a5749027ca a irccf:MITREMitigationAssertion ;
    dcterms:description """Limit access to remote services through centrally managed concentrators such as VPNs and other managed remote access systems.
""" ;
    dcterms:modified "2026-04-29T14:23:05.966Z" ;
    irccf:mitigation irccf:MITRE_M0935 ;
    irccf:mitigationSourceRecord "relationship--2daeeaaa-5b4b-4bb7-a94d-78a5749027ca" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0822_ExternalRemoteServices .

irccf:MitigationAssertion_2de38f5e_b97c_498a_a4c9_f13e5d2d233c a irccf:MITREMitigationAssertion ;
    dcterms:description "Devices and programs that receive command messages from remote systems (e.g., control servers) should verify those commands before taking any actions on them." ;
    dcterms:modified "2026-04-29T14:23:05.967Z" ;
    irccf:mitigation irccf:MITRE_M0818 ;
    irccf:mitigationSourceRecord "relationship--2de38f5e-b97c-498a-a4c9-f13e5d2d233c" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1692_001_CommandMessage .

irccf:MitigationAssertion_2e5f338d_92c4_4647_8fef_7c901ff774f5 a irccf:MITREMitigationAssertion ;
    dcterms:description """Protect files stored locally with proper permissions to limit opportunities for adversaries to interact and collect information from databases. (Citation: Keith Stouffer May 2015) (Citation: National Institute of Standards and Technology April 2013)
""" ;
    dcterms:modified "2026-04-29T14:23:05.967Z" ;
    irccf:mitigation irccf:MITRE_M0922 ;
    irccf:mitigationSourceRecord "relationship--2e5f338d-92c4-4647-8fef-7c901ff774f5" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0882_TheftOfOperationalInformation .

irccf:MitigationAssertion_2ecc567f_3aaa_4bd8_935f_4808d177a552 a irccf:MITREMitigationAssertion ;
    dcterms:description """Use host-based allowlists to prevent devices from accepting connections from unauthorized systems. For example, allowlists can be used to ensure devices can only connect with master stations or known management/engineering workstations. (Citation: Department of Homeland Security September 2016)
""" ;
    dcterms:modified "2026-04-29T14:23:05.968Z" ;
    irccf:mitigation irccf:MITRE_M0807 ;
    irccf:mitigationSourceRecord "relationship--2ecc567f-3aaa-4bd8-935f-4808d177a552" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0861_PointAndTagIdentification .

irccf:MitigationAssertion_2f64b5aa_7e4d_4a5e_9960_69a63ad25083 a irccf:MITREMitigationAssertion ;
    dcterms:description """Execution prevention may prevent malicious scripts from accessing protected resources.
""" ;
    dcterms:modified "2026-04-29T14:23:05.971Z" ;
    irccf:mitigation irccf:MITRE_M0938 ;
    irccf:mitigationSourceRecord "relationship--2f64b5aa-7e4d-4a5e-9960-69a63ad25083" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0853_Scripting .

irccf:MitigationAssertion_2f6b635b_1441_4ef0_9289_1ed6b9098d4a a irccf:MITREMitigationAssertion ;
    dcterms:description """Reduce the range of RF communications to their intended operating range when possible. Propagation reduction methods may include (i) reducing transmission power on wireless signals, (ii) adjusting antenna gain to prevent extensions beyond organizational boundaries, and (iii) employing RF shielding techniques to block excessive signal propagation.  (Citation: DHS  National Urban Security Technology Laboratory April 2019)
""" ;
    dcterms:modified "2026-04-29T14:23:05.971Z" ;
    irccf:mitigation irccf:MITRE_M0806 ;
    irccf:mitigationSourceRecord "relationship--2f6b635b-1441-4ef0-9289-1ed6b9098d4a" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0887_WirelessSniffing .

irccf:MitigationAssertion_2f8c9deb_aefe_4fa3_b00c_ec15fd154233 a irccf:MITREMitigationAssertion ;
    dcterms:description """Perform inline allowlisting of automation protocol commands  to prevent devices from sending unauthorized command or reporting messages. Allow/denylist techniques need to be designed with sufficient accuracy to prevent the unintended blocking of valid messages.
""" ;
    dcterms:modified "2026-04-29T14:23:05.972Z" ;
    irccf:mitigation irccf:MITRE_M0937 ;
    irccf:mitigationSourceRecord "relationship--2f8c9deb-aefe-4fa3-b00c-ec15fd154233" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1692_001_CommandMessage .

irccf:MitigationAssertion_2fbb7867_79c5_4d45_9876_98c4041dd72e a irccf:MITREMitigationAssertion ;
    dcterms:description """Consider implementing full disk encryption, especially if engineering workstations are transient assets that are more likely to be lost, stolen, or tampered with. (Citation: National Institute of Standards and Technology April 2013)
""" ;
    dcterms:modified "2026-04-29T14:23:05.974Z" ;
    irccf:mitigation irccf:MITRE_M0941 ;
    irccf:mitigationSourceRecord "relationship--2fbb7867-79c5-4d45-9876-98c4041dd72e" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0864_TransientCyberAsset .

irccf:MitigationAssertion_2ff82993_5010_4450_89e7_341f449f3263 a irccf:MITREMitigationAssertion ;
    dcterms:description """Consider periodic reviews of accounts and privileges for critical and sensitive repositories.
""" ;
    dcterms:modified "2026-04-29T14:23:05.975Z" ;
    irccf:mitigation irccf:MITRE_M0947 ;
    irccf:mitigationSourceRecord "relationship--2ff82993-5010-4450-89e7-341f449f3263" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0811_DataFromInformationRepositories .

irccf:MitigationAssertion_2fffbea8_c031_4de8_a451_447bbbe3e224 a irccf:MITREMitigationAssertion ;
    dcterms:description """Consider the use of application isolation and sandboxing to restrict specific operating system interactions such as access through user accounts, services, system calls, registry, and network access. This may be even more useful in cases where the source of the executed script is unknown.
""" ;
    dcterms:modified "2026-04-29T14:23:05.976Z" ;
    irccf:mitigation irccf:MITRE_M0948 ;
    irccf:mitigationSourceRecord "relationship--2fffbea8-c031-4de8-a451-447bbbe3e224" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0853_Scripting .

irccf:MitigationAssertion_3003564d_fb12_4509_946b_818e4e5b8431 a irccf:MITREMitigationAssertion ;
    dcterms:description """Devices should authenticate all messages between master and outstation assets.
""" ;
    dcterms:modified "2026-04-29T14:23:05.976Z" ;
    irccf:mitigation irccf:MITRE_M0813 ;
    irccf:mitigationSourceRecord "relationship--3003564d-fb12-4509-946b-818e4e5b8431" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1692_001_CommandMessage .

irccf:MitigationAssertion_31b8d0d3_2e81_4367_80c0_1173988e77d7 a irccf:MITREMitigationAssertion ;
    dcterms:description "Protocols used for device management should authenticate all network messages to prevent unauthorized system changes." ;
    dcterms:modified "2026-04-29T14:23:05.982Z" ;
    irccf:mitigation irccf:MITRE_M0802 ;
    irccf:mitigationSourceRecord "relationship--31b8d0d3-2e81-4367-80c0-1173988e77d7" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0843_001_DownloadAll .

irccf:MitigationAssertion_33215dfa_53d0_4bd7_a15d_cec9315c7c4d a irccf:MITREMitigationAssertion ;
    dcterms:description """Deny direct remote access to internal systems through the use of network proxies, gateways, and firewalls. Steps should be taken to periodically inventory internet accessible devices to determine if it differs from the expected.
""" ;
    dcterms:modified "2026-04-29T14:23:05.986Z" ;
    irccf:mitigation irccf:MITRE_M0930 ;
    irccf:mitigationSourceRecord "relationship--33215dfa-53d0-4bd7-a15d-cec9315c7c4d" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0883_InternetAccessibleDevice .

irccf:MitigationAssertion_337f366d_3d76_470c_8ee2_0e2252648282 a irccf:MITREMitigationAssertion ;
    dcterms:description "Disallow the execution of applications/programs which are not required for normal system functions, including any specific command-line arguments which may allow the execution of proxy commands or application binaries." ;
    dcterms:modified "2026-04-29T14:23:05.986Z" ;
    irccf:mitigation irccf:MITRE_M0938 ;
    irccf:mitigationSourceRecord "relationship--337f366d-3d76-470c-8ee2-0e2252648282" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0894_SystemBinaryProxyExecution .

irccf:MitigationAssertion_3478c49c_594b_4224_b7f9_2b0b09c67288 a irccf:MITREMitigationAssertion ;
    dcterms:description """Utilize strong cryptographic techniques and protocols to prevent eavesdropping on network communications.  (Citation: Bastille April 2017)
""" ;
    dcterms:modified "2026-04-29T14:23:05.989Z" ;
    irccf:mitigation irccf:MITRE_M0808 ;
    irccf:mitigationSourceRecord "relationship--3478c49c-594b-4224-b7f9-2b0b09c67288" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0887_WirelessSniffing .

irccf:MitigationAssertion_34ac1b1b_1103_4fc9_a62e_f1dd1451b28b a irccf:MITREMitigationAssertion ;
    dcterms:description """Provide the ability to verify the integrity of control logic or programs loaded on a controller. While techniques like CRCs and checksums are commonly used, they are not cryptographically strong and can be vulnerable to collisions. Preferably cryptographic hash functions (e.g., SHA-2, SHA-3) should be used. (Citation: IEC February 2019)
""" ;
    dcterms:modified "2026-04-29T14:23:05.990Z" ;
    irccf:mitigation irccf:MITRE_M0947 ;
    irccf:mitigationSourceRecord "relationship--34ac1b1b-1103-4fc9-a62e-f1dd1451b28b" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0889_ModifyProgram .

irccf:MitigationAssertion_34d4101b_b4c9_4ea3_a84d_81e84e7f5033 a irccf:MITREMitigationAssertion ;
    dcterms:description """Segment networks and systems appropriately to reduce access to critical system and services communications.
""" ;
    dcterms:modified "2026-04-29T14:23:05.990Z" ;
    irccf:mitigation irccf:MITRE_M0930 ;
    irccf:mitigationSourceRecord "relationship--34d4101b-b4c9-4ea3-a84d-81e84e7f5033" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0842_NetworkSniffing .

irccf:MitigationAssertion_34dcc9e8_a43a_475b_81b6_b15240545075 a irccf:MITREMitigationAssertion ;
    dcterms:description """Segment operational assets and their management devices based on their functional role within the process. Enabling more strict isolation to more critical control and operational information within the control environment.(Citation: Karen Scarfone; Paul Hoffman September 2009)(Citation: Keith Stouffer May 2015)(Citation: Department of Homeland Security September 2016)(Citation: Dwight Anderson 2014) 
""" ;
    dcterms:modified "2026-04-29T14:23:05.990Z" ;
    irccf:mitigation irccf:MITRE_M0930 ;
    irccf:mitigationSourceRecord "relationship--34dcc9e8-a43a-475b-81b6-b15240545075" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1692_002_ReportingMessage .

irccf:MitigationAssertion_35cf6922_d48f_42ea_b7f5_f0258892bd52 a irccf:MITREMitigationAssertion ;
    dcterms:description """Network segmentation can be used to isolate infrastructure components that do not require broad network access. This may mitigate, or at least alleviate, the scope of AiTM activity.
""" ;
    dcterms:modified "2026-04-29T14:23:05.993Z" ;
    irccf:mitigation irccf:MITRE_M0930 ;
    irccf:mitigationSourceRecord "relationship--35cf6922-d48f-42ea-b7f5-f0258892bd52" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0830_AdversaryInTheMiddle .

irccf:MitigationAssertion_366a4cd1_aa95_4985_9d80_b45a2551e298 a irccf:MITREMitigationAssertion ;
    dcterms:description """Filter for protocols and payloads associated with program download activity to prevent unauthorized device configurations.
""" ;
    dcterms:modified "2026-04-29T14:23:05.994Z" ;
    irccf:mitigation irccf:MITRE_M0937 ;
    irccf:mitigationSourceRecord "relationship--366a4cd1-aa95-4985-9d80-b45a2551e298" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0843_ProgramDownload .

irccf:MitigationAssertion_3680ab7a_254b_426c_b417_460712c2f357 a irccf:MITREMitigationAssertion ;
    dcterms:description "Ensure proper network segmentation is followed to protect critical servers and devices." ;
    dcterms:modified "2026-04-29T14:23:05.994Z" ;
    irccf:mitigation irccf:MITRE_M0930 ;
    irccf:mitigationSourceRecord "relationship--3680ab7a-254b-426c-b417-460712c2f357" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0846_003_MulticastDiscovery .

irccf:MitigationAssertion_39dcfc44_5f18_475f_b431_22032a14cbe5 a irccf:MITREMitigationAssertion ;
    dcterms:description "Segment operational networks to isolate critical systems and devices that do not require broad network access." ;
    dcterms:modified "2026-04-29T14:23:05.999Z" ;
    irccf:mitigation irccf:MITRE_M0930 ;
    irccf:mitigationSourceRecord "relationship--39dcfc44-5f18-475f-b431-22032a14cbe5" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1695_003_WiFi .

irccf:MitigationAssertion_3a6cd53d_0d4e_4cf8_8edf_f9ebde4faac4 a irccf:MITREMitigationAssertion ;
    dcterms:description "All field controllers should require users to authenticate for all remote or local management sessions. The authentication mechanisms should also support [Account Use Policies](https://attack.mitre.org/mitigations/M0936), [Password Policies](https://attack.mitre.org/mitigations/M0927), and [User Account Management](https://attack.mitre.org/mitigations/M0918)." ;
    dcterms:modified "2026-04-29T14:23:06.001Z" ;
    irccf:mitigation irccf:MITRE_M0804 ;
    irccf:mitigationSourceRecord "relationship--3a6cd53d-0d4e-4cf8-8edf-f9ebde4faac4" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0816_DeviceRestartShutdown .

irccf:MitigationAssertion_3ab912a4_70aa_45f8_b2ef_57113dde2cfa a irccf:MITREMitigationAssertion ;
    dcterms:description """Do not inherently rely on the authenticity provided by the network/link layer (e.g., 802.11, LTE, 802.15.4), as link layer equipment may have long lifespans and protocol vulnerabilities may not be easily patched. Provide defense-in-depth by implementing authenticity within the associated application-layer protocol, or through a network-layer VPN. (Citation: CISA March 2010)  Furthermore, ensure communication schemes provide strong replay protection, employing techniques such as timestamps or cryptographic nonces.
""" ;
    dcterms:modified "2026-04-29T14:23:06.001Z" ;
    irccf:mitigation irccf:MITRE_M0802 ;
    irccf:mitigationSourceRecord "relationship--3ab912a4-70aa-45f8-b2ef-57113dde2cfa" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0860_WirelessCompromise .

irccf:MitigationAssertion_3b6567a9_6213_4db4_a069_1a86b1098b63 a irccf:MITREMitigationAssertion ;
    dcterms:description """Security applications that look for behavior used during exploitation such as Windows Defender Exploit Guard (WDEG) and the Enhanced Mitigation Experience Toolkit (EMET) can be used to mitigate some exploitation behavior. (Citation: Microsoft Security Response Center August 2017) Control flow integrity checking is another way to potentially identify and stop a software exploit from occurring. (Citation: Wikipedia) Many of these protections depend on the architecture and target application binary for compatibility and may not work for all software or services targeted.
""" ;
    dcterms:modified "2026-04-29T14:23:06.003Z" ;
    irccf:mitigation irccf:MITRE_M0950 ;
    irccf:mitigationSourceRecord "relationship--3b6567a9-6213-4db4-a069-1a86b1098b63" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0890_ExploitationForPrivilegeEscalation .

irccf:MitigationAssertion_3b9a4916_78b9_44b3_b0fc_6f167a918d7d a irccf:MITREMitigationAssertion ;
    dcterms:description "All field controllers should require users to authenticate for all remote or local management sessions. The authentication mechanisms should also support [Account Use Policies](https://attack.mitre.org/mitigations/M0936), [Password Policies](https://attack.mitre.org/mitigations/M0927), and [User Account Management](https://attack.mitre.org/mitigations/M0918)." ;
    dcterms:modified "2026-04-29T14:23:06.003Z" ;
    irccf:mitigation irccf:MITRE_M0804 ;
    irccf:mitigationSourceRecord "relationship--3b9a4916-78b9-44b3-b0fc-6f167a918d7d" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0843_002_OnlineEdit .

irccf:MitigationAssertion_3cf99739_b045_4a83_985d_e9984076b81d a irccf:MITREMitigationAssertion ;
    dcterms:description "ll field controllers should restrict the download of programs, including online edits and program appends, to only certain users (e.g., engineers, field technician), preferably through implementing a role-based access mechanism." ;
    dcterms:modified "2026-04-29T14:23:06.008Z" ;
    irccf:mitigation irccf:MITRE_M0800 ;
    irccf:mitigationSourceRecord "relationship--3cf99739-b045-4a83-985d-e9984076b81d" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0843_001_DownloadAll .

irccf:MitigationAssertion_3d676c1b_2650_4599_8a57_790c55f9977d a irccf:MITREMitigationAssertion ;
    dcterms:description """Minimize the exposure of API calls that allow the execution of code.
""" ;
    dcterms:modified "2026-04-29T14:23:06.009Z" ;
    irccf:mitigation irccf:MITRE_M0938 ;
    irccf:mitigationSourceRecord "relationship--3d676c1b-2650-4599-8a57-790c55f9977d" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0871_ExecutionThroughAPI .

irccf:MitigationAssertion_3e249f0a_5755_4e0f_96ce_f3ce6376fed5 a irccf:MITREMitigationAssertion ;
    dcterms:description """Provide an alternative method for sending critical report messages to operators, this could include using radio/cell communication to obtain messages from field technicians that can locally obtain telemetry and status data.
""" ;
    dcterms:modified "2026-04-29T14:23:06.010Z" ;
    irccf:mitigation irccf:MITRE_M0810 ;
    irccf:mitigationSourceRecord "relationship--3e249f0a-5755-4e0f-96ce-f3ce6376fed5" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1691_002_ReportingMessage .

irccf:MitigationAssertion_3f335e8f_68da_4b06_9d96_f371ddaf23e6 a irccf:MITREMitigationAssertion ;
    dcterms:description """Ensure wireless networks require the authentication of all devices, and that all wireless devices also authenticate network infrastructure devices (i.e., mutual authentication). For defense-in-depth purposes, utilize VPNs or ensure that application-layer protocols also authenticate the system or device. Use protocols that provide strong authentication (e.g., IEEE 802.1X), and enforce basic protections, such as MAC filtering, when stronger cryptographic techniques are not available.
""" ;
    dcterms:modified "2026-04-29T14:23:06.011Z" ;
    irccf:mitigation irccf:MITRE_M0813 ;
    irccf:mitigationSourceRecord "relationship--3f335e8f-68da-4b06-9d96-f371ddaf23e6" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0860_WirelessCompromise .

irccf:MitigationAssertion_41abc220_4ec6_41cc_bb36_37c43341fc41 a irccf:MITREMitigationAssertion ;
    dcterms:description "Use host-based allowlists to prevent devices from accepting connections from unauthorized systems. For example, allowlists can be used to ensure devices can only connect with master stations or known management/engineering workstations.(Citation: Department of Homeland Security September 2016)" ;
    dcterms:modified "2026-04-29T14:23:06.015Z" ;
    irccf:mitigation irccf:MITRE_M0807 ;
    irccf:mitigationSourceRecord "relationship--41abc220-4ec6-41cc-bb36-37c43341fc41" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1693_ModifyFirmware .

irccf:MitigationAssertion_41adaf0b_b7ae_4bdb_9a5b_567fd0911d7a a irccf:MITREMitigationAssertion ;
    dcterms:description """Protocols used for control functions should provide authenticity through MAC functions or digital signatures. If not, utilize bump-in-the-wire devices or VPNs to enforce communication authenticity between devices that are not capable of supporting this (e.g., legacy controllers, RTUs).
""" ;
    dcterms:modified "2026-04-29T14:23:06.015Z" ;
    irccf:mitigation irccf:MITRE_M0802 ;
    irccf:mitigationSourceRecord "relationship--41adaf0b-b7ae-4bdb-9a5b-567fd0911d7a" ;
    irccf:mitreDataVersion "ICS v19.2" ;
