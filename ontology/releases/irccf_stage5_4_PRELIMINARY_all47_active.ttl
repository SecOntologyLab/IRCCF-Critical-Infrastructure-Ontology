irccf:MitigationAssertion_ae0b459d_535d_4895_ac9f_6ec0518afe00 a irccf:MITREMitigationAssertion ;
    dcterms:description "Ensure embedded controls and network devices are protected through access management, as these devices often have insecure credentials which could be used to gain unauthorized access." ;
    dcterms:modified "2026-04-29T14:23:06.162Z" ;
    irccf:mitigation irccf:MITRE_M0801 ;
    irccf:mitigationSourceRecord "relationship--ae0b459d-535d-4895-ac9f-6ec0518afe00" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1694_InsecureCredentials .

irccf:MitigationAssertion_ae10e97a_90ac_498b_8601_01081dc4af8b a irccf:MITREMitigationAssertion ;
    dcterms:description """Limit the accounts that may use remote services. Limit the permissions for accounts that are at higher risk of compromise; for example, configure SSH so users can only run specific programs.
""" ;
    dcterms:modified "2026-04-29T14:23:06.162Z" ;
    irccf:mitigation irccf:MITRE_M0918 ;
    irccf:mitigationSourceRecord "relationship--ae10e97a-90ac-498b-8601-01081dc4af8b" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0886_RemoteServices .

irccf:MitigationAssertion_ae1e5c1a_8f2f_4a5a_a262_3d485c20e7a0 a irccf:MITREMitigationAssertion ;
    dcterms:description "Segment operational networks to isolate critical systems and devices that do not require broad network access." ;
    dcterms:modified "2026-04-29T14:23:06.162Z" ;
    irccf:mitigation irccf:MITRE_M0930 ;
