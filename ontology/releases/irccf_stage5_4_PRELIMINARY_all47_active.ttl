irccf:MitigationAssertion_ae7487f1_a2d0_443d_b418_cd726c5ac15f a irccf:MITREMitigationAssertion ;
    dcterms:description """Network connection enumeration is likely obtained by using common system tools (e.g., netstat, ipconfig).
""" ;
    dcterms:modified "2026-04-29T14:23:06.162Z" ;
    irccf:mitigation irccf:MITRE_M0816 ;
    irccf:mitigationSourceRecord "relationship--ae7487f1-a2d0-443d-b418-cd726c5ac15f" ;
