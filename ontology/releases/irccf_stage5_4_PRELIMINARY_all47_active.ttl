irccf:MitigationAssertion_d16e8909_d055_4174_aeb1_22c0613b2f73 a irccf:MITREMitigationAssertion ;
    dcterms:description """Disable unnecessary legacy network protocols that may be used for AiTM if applicable.
""" ;
    dcterms:modified "2026-04-29T14:23:06.212Z" ;
    irccf:mitigation irccf:MITRE_M0942 ;
    irccf:mitigationSourceRecord "relationship--d16e8909-d055-4174-aeb1-22c0613b2f73" ;
