irccf:MitigationAssertion_d1d98f8c_aea2_4f06_9b0d_c543ed42c6a4 a irccf:MITREMitigationAssertion ;
    dcterms:description """Ensure that all SIS are segmented from operational networks to prevent them from being targeted by additional adversarial behavior.
""" ;
    dcterms:modified "2026-04-29T14:23:06.212Z" ;
    irccf:mitigation irccf:MITRE_M0812 ;
    irccf:mitigationSourceRecord "relationship--d1d98f8c-aea2-4f06-9b0d-c543ed42c6a4" ;
