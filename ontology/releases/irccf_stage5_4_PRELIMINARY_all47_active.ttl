irccf:MitigationAssertion_b8f6d6a8_e668_4596_8ec2_41c5d1bd211d a irccf:MITREMitigationAssertion ;
    dcterms:description """All field controllers should restrict the modification of programs to only certain users (e.g., engineers, field technician), preferably through implementing a role-based access mechanism.
""" ;
    dcterms:modified "2026-04-29T14:23:06.178Z" ;
    irccf:mitigation irccf:MITRE_M0800 ;
    irccf:mitigationSourceRecord "relationship--b8f6d6a8-e668-4596-8ec2-41c5d1bd211d" ;
    irccf:mitreDataVersion "ICS v19.2" ;
