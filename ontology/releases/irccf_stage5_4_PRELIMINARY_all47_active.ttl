    irccf:technique irccf:T1693_ModifyFirmware .

irccf:MitigationAssertion_d4f64f95_42cd_46e6_8fcf_25ef0d868f5b a irccf:MITREMitigationAssertion ;
    dcterms:description "Authenticate all access to field controllers before authorizing access to, or modification of, a device's state, logic, or programs. Centralized authentication techniques can help manage the large number of field controller accounts needed across the ICS." ;
    dcterms:modified "2026-04-29T14:23:06.216Z" ;
    irccf:mitigation irccf:MITRE_M0801 ;
    irccf:mitigationSourceRecord "relationship--d4f64f95-42cd-46e6-8fcf-25ef0d868f5b" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0843_003_ProgramAppend .

irccf:MitigationAssertion_d67feaac_73ac_47b1_91ec_f537105afc58 a irccf:MITREMitigationAssertion ;
    dcterms:description "When at rest, project files should be encrypted to prevent unauthorized changes.(Citation: National Institute of Standards and Technology April 2013)" ;
    dcterms:modified "2026-04-29T14:23:06.218Z" ;
    irccf:mitigation irccf:MITRE_M0941 ;
    irccf:mitigationSourceRecord "relationship--d67feaac-73ac-47b1-91ec-f537105afc58" ;
