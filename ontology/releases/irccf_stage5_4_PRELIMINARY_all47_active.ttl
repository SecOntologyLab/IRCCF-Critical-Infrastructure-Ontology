    irccf:technique irccf:T0884_ConnectionProxy .

irccf:MitigationAssertion_21b6ec9c_8779_49db_bf19_90e81893a6e4 a irccf:MITREMitigationAssertion ;
    dcterms:description """Protect files stored locally with proper permissions  to limit opportunities for adversaries to impact data storage. (Citation: National Institute of Standards and Technology April 2013)
""" ;
    dcterms:modified "2026-04-29T14:23:05.951Z" ;
    irccf:mitigation irccf:MITRE_M0922 ;
    irccf:mitigationSourceRecord "relationship--21b6ec9c-8779-49db-bf19-90e81893a6e4" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0809_DataDestruction .

irccf:MitigationAssertion_21c7b1bb_ba40_4843_b462_079b1b85c01b a irccf:MITREMitigationAssertion ;
    dcterms:description "Segment operational network and systems to restrict access to critical system functions to predetermined management systems.(Citation: Department of Homeland Security September 2016)" ;
    dcterms:modified "2026-04-29T14:23:05.951Z" ;
    irccf:mitigation irccf:MITRE_M0930 ;
    irccf:mitigationSourceRecord "relationship--21c7b1bb-ba40-4843-b462-079b1b85c01b" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1693_ModifyFirmware .

irccf:MitigationAssertion_220140ac_d927_4d86_9335_c04aa6ee3c61 a irccf:MITREMitigationAssertion ;
    dcterms:description """Deny direct remote access to internal systems through the use of network proxies, gateways, and firewalls. Consider a jump server or host into the DMZ for greater access control. Leverage this DMZ or corporate resources for vendor access. (Citation: Keith Stouffer May 2015)
""" ;
    dcterms:modified "2026-04-29T14:23:05.951Z" ;
    irccf:mitigation irccf:MITRE_M0930 ;
    irccf:mitigationSourceRecord "relationship--220140ac-d927-4d86-9335-c04aa6ee3c61" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0822_ExternalRemoteServices .

irccf:MitigationAssertion_22448288_32d9_4d2c_be16_0784e119fff1 a irccf:MITREMitigationAssertion ;
    dcterms:description "All field controllers should require users to authenticate for all remote or local management sessions. The authentication mechanisms should also support [Account Use Policies](https://attack.mitre.org/mitigations/M0936), [Password Policies](https://attack.mitre.org/mitigations/M0927), and [User Account Management](https://attack.mitre.org/mitigations/M0918)." ;
    dcterms:modified "2026-04-29T14:23:05.952Z" ;
    irccf:mitigation irccf:MITRE_M0804 ;
    irccf:mitigationSourceRecord "relationship--22448288-32d9-4d2c-be16-0784e119fff1" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0858_ChangeOperatingMode .

irccf:MitigationAssertion_238f967a_0c29_4aa3_bbb5_3dc593473bbf a irccf:MITREMitigationAssertion ;
    dcterms:description """Security applications that look for behavior used during exploitation such as Windows Defender Exploit Guard (WDEG) and the Enhanced Mitigation Experience Toolkit (EMET) can be used to mitigate some exploitation behavior. (Citation: Microsoft Security Response Center August 2017) Control flow integrity checking is another way to potentially identify and stop a software exploit from occurring. (Citation: Wikipedia) Many of these protections depend on the architecture and target application binary for compatibility and may not work for all software or services targeted.
""" ;
    dcterms:modified "2026-04-29T14:23:05.953Z" ;
    irccf:mitigation irccf:MITRE_M0950 ;
    irccf:mitigationSourceRecord "relationship--238f967a-0c29-4aa3-bbb5-3dc593473bbf" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0820_ExploitationForEvasion .

irccf:MitigationAssertion_23f33619_c64e_4999_85c1_b5c88e570e46 a irccf:MITREMitigationAssertion ;
    dcterms:description """Ensure embedded controls and network devices are protected through access management, as these devices often have unknown default accounts which could be used to gain unauthorized access.
""" ;
    dcterms:modified "2026-04-29T14:23:05.954Z" ;
    irccf:mitigation irccf:MITRE_M0801 ;
    irccf:mitigationSourceRecord "relationship--23f33619-c64e-4999-85c1-b5c88e570e46" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1694_001_DefaultCredentials .

irccf:MitigationAssertion_242b5a0d_e4e8_4ceb_a975_cf8efd64e981 a irccf:MITREMitigationAssertion ;
    dcterms:description """Protection devices should have minimal digital components to prevent exposure to related adversarial techniques. Examples include interlocks, rupture disks, release valves, etc. (Citation: A G Foord, W G Gulland, C R Howard, T Kellacher, W H Smith 2004) 
""" ;
    dcterms:modified "2026-04-29T14:23:05.955Z" ;
    irccf:mitigation irccf:MITRE_M0805 ;
    irccf:mitigationSourceRecord "relationship--242b5a0d-e4e8-4ceb-a975-cf8efd64e981" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0880_LossOfSafety .

irccf:MitigationAssertion_243ad7b2_546c_4bf2_a3c0_1438b13e197d a irccf:MITREMitigationAssertion ;
    dcterms:description """Systems and devices should restrict access to any data with potential confidentiality concerns, including point and tag information.
""" ;
    dcterms:modified "2026-04-29T14:23:05.955Z" ;
    irccf:mitigation irccf:MITRE_M0800 ;
    irccf:mitigationSourceRecord "relationship--243ad7b2-546c-4bf2-a3c0-1438b13e197d" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0861_PointAndTagIdentification .

irccf:MitigationAssertion_246ba662_bd89_4295_b603_582ebad285da a irccf:MITREMitigationAssertion ;
    dcterms:description "Filter for protocols and payloads associated with program download activity to prevent unauthorized device configurations." ;
    dcterms:modified "2026-04-29T14:23:05.955Z" ;
    irccf:mitigation irccf:MITRE_M0937 ;
    irccf:mitigationSourceRecord "relationship--246ba662-bd89-4295-b603-582ebad285da" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0843_003_ProgramAppend .

irccf:MitigationAssertion_26fdd07e_d194_4f8e_a9af_d5b2f1d0222e a irccf:MITREMitigationAssertion ;
    dcterms:description """Restrict root or administrator access on user accounts to limit the ability to capture promiscuous traffic on a network through common packet capture tools. (Citation: National Institute of Standards and Technology April 2013)
""" ;
    dcterms:modified "2026-04-29T14:23:05.958Z" ;
    irccf:mitigation irccf:MITRE_M0926 ;
    irccf:mitigationSourceRecord "relationship--26fdd07e-d194-4f8e-a9af-d5b2f1d0222e" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0842_NetworkSniffing .

irccf:MitigationAssertion_276aa6a6_e700_470a_8f72_02537ba7be9d a irccf:MITREMitigationAssertion ;
    dcterms:description """Configure features related to account use like login attempt lockouts, specific login times, and password strength requirements as examples. Consider these features as they relate to assets which may impact safety and availability. (Citation: Keith Stouffer May 2015)
""" ;
    dcterms:modified "2026-04-29T14:23:05.958Z" ;
    irccf:mitigation irccf:MITRE_M0936 ;
    irccf:mitigationSourceRecord "relationship--276aa6a6-e700-470a-8f72-02537ba7be9d" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0822_ExternalRemoteServices .

irccf:MitigationAssertion_28b06a92_2933_49f5_887e_c09cf1bb861f a irccf:MITREMitigationAssertion ;
    dcterms:description "Implement network allowlists to minimize network access to only authorized hosts." ;
    dcterms:modified "2026-04-29T14:23:05.960Z" ;
    irccf:mitigation irccf:MITRE_M0807 ;
    irccf:mitigationSourceRecord "relationship--28b06a92-2933-49f5-887e-c09cf1bb861f" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1695_003_WiFi .

irccf:MitigationAssertion_28bb99c4_ac44_406c_bd5d_cabb273363fb a irccf:MITREMitigationAssertion ;
    dcterms:description "Authenticate connections from software and devices to prevent unauthorized systems from accessing protected management functions." ;
