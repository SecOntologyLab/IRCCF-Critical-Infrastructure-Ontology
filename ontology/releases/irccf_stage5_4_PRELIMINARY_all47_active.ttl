irccf:MitigationAssertion_7fdaa9be_aecf_459f_b028_7c35dc8b6451 a irccf:MITREMitigationAssertion ;
    dcterms:description """Limit privileges of user accounts and groups so that only designated administrators or engineers can interact with alarm management and alarm configuration thresholds.
""" ;
    dcterms:modified "2026-04-29T14:23:06.100Z" ;
    irccf:mitigation irccf:MITRE_M0918 ;
    irccf:mitigationSourceRecord "relationship--7fdaa9be-aecf-459f-b028-7c35dc8b6451" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0838_ModifyAlarmSettings .

irccf:MitigationAssertion_7ff12adb_bc9a_42e5_9cbf_613b200c36dc a irccf:MITREMitigationAssertion ;
    dcterms:description """Make it difficult for adversaries to advance their operation through exploitation of undiscovered or unpatched vulnerabilities by using sandboxing. Other types of virtualization and application microsegmentation may also mitigate the impact of some types of exploitation. Risks of additional exploits and weaknesses in these systems may still exist. (Citation: Dan Goodin March 2017)
""" ;
    dcterms:modified "2026-04-29T14:23:06.100Z" ;
    irccf:mitigation irccf:MITRE_M0948 ;
    irccf:mitigationSourceRecord "relationship--7ff12adb-bc9a-42e5-9cbf-613b200c36dc" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0820_ExploitationForEvasion .

irccf:MitigationAssertion_808174b7_3ab0_45b5_963e_5c10dd749e3c a irccf:MITREMitigationAssertion ;
    dcterms:description """Statically defined ARP entries can prevent manipulation and sniffing of switched network traffic, as some AiTM techniques depend on sending spoofed ARP messages to manipulate network host's dynamic ARP tables.
""" ;
    dcterms:modified "2026-04-29T14:23:06.101Z" ;
    irccf:mitigation irccf:MITRE_M0814 ;
    irccf:mitigationSourceRecord "relationship--808174b7-3ab0-45b5-963e-5c10dd749e3c" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0830_AdversaryInTheMiddle .

irccf:MitigationAssertion_808c57e7_72ef_4860_b9ea_8ea072e2385a a irccf:MITREMitigationAssertion ;
    dcterms:description """Protocols used for control functions should provide authenticity through MAC functions or digital signatures. If not, utilize bump-in-the-wire devices or VPNs to enforce communication authenticity between devices that are not capable of supporting this (e.g., legacy controllers, RTUs).
""" ;
