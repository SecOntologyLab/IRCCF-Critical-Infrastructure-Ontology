irccf:AIAct a irccf:Regulation ;
    rdfs:label "EU AI Act" ;
    irccf:imposesRequirement irccf:AIAct_Art__14_1__4,
        <https://purl.org/ircc-framework#AIAct_Art__15_1,_5>,
        irccf:AIAct_Art__26_1__2,
        irccf:AIAct_Art__26_4__6,
        irccf:AIAct_Art__9_1__2 .

irccf:AccessControlEnforcement a irccf:SecurityControl ;
    rdfs:label "Access control enforcement (SR 1.1)" ;
    irccf:belongsToStandard irccf:IEC_62443_3_3 ;
    irccf:description "Human user identification and authentication." ;
    irccf:mitigates irccf:T0812_DefaultCredentials,
        irccf:T0822_ExternalRemoteServices,
        irccf:T0859_ValidAccounts,
        irccf:T0886_RemoteServices,
        irccf:T0891_HardcodedCredentials,
        irccf:T0892_ChangeCredential .

irccf:AnomalyDetectionControl a irccf:SecurityControl ;
    rdfs:label "Anomaly detection control" ;
    irccf:belongsToStandard irccf:IEC_62443_3_3 ;
    irccf:mitigates irccf:T0806_BruteForceIO,
        irccf:T0821_ModifyControllerTasking,
        irccf:T0835_ManipulateIOImage,
        irccf:T0836_ModifyParameter,
        irccf:T0855_UnauthorizedCommandMessage,
        irccf:T0856_SpoofReportingMessage,
        irccf:T0858_ChangeOperatingMode,
        irccf:T0878_AlarmSuppression .

irccf:AuditLoggingControl a irccf:SecurityControl ;
    rdfs:label "Audit logging control (SR 2.8)" ;
    irccf:belongsToStandard irccf:IEC_62443_3_3 ;
    irccf:description "Auditable events and tamper-proof logging." ;
    irccf:mitigates irccf:T0849_Masquerading,
        irccf:T0872_IndicatorRemovalOnHost,
        irccf:T0894_SystemBinaryProxyExecution .

irccf:BackupRecoveryControl a irccf:SecurityControl ;
    rdfs:label "Backup and recovery control (SR 7.3)" ;
    irccf:belongsToStandard irccf:IEC_62443_3_3 ;
    irccf:description "System backup and recovery capabilities." ;
    irccf:mitigates irccf:T0809_DataDestruction,
        irccf:T0826_LossOfAvailability .

irccf:CRA a irccf:Regulation ;
    rdfs:label "Cyber Resilience Act" ;
    irccf:imposesRequirement irccf:CRA_Annex_I_Part_II_1__3,
        irccf:CRA_Annex_I_Part_I_1,
        irccf:CRA_Annex_I_Part_I_2_a__c,
        irccf:CRA_Annex_I_Part_I_2_d__h,
        irccf:CRA_Art__13_1__3,
        irccf:CRA_Art__13_6__8,
        irccf:CRA_Art__14 .

irccf:CTIAnalysisProvider a irccf:Stakeholder .

irccf:CTIPlatform a irccf:Asset ;
    rdfs:label "CTI sharing platform" ;
    irccf:involvesProcessing irccf:ThreatSharing ;
    irccf:usedInCaseStudy irccf:CTICaseStudy .

irccf:CommunicationIntegrityControl a irccf:SecurityControl ;
    rdfs:label "Communication integrity control (SR 3.1)" ;
    irccf:belongsToStandard irccf:IEC_62443_3_3 ;
    irccf:description "Communication integrity protection." ;
    irccf:mitigates irccf:T0803_BlockCommandMessage,
        irccf:T0804_BlockReportingMessage,
        irccf:T0830_AdversaryInTheMiddle,
        irccf:T0848_RogueMaster .

irccf:ComplianceMeasure a owl:Class .

irccf:DataConfidentialityControl a irccf:SecurityControl ;
    rdfs:label "Data confidentiality control (SR 4.1)" ;
    irccf:belongsToStandard irccf:IEC_62443_3_3 ;
    irccf:description "Information confidentiality protection." ;
    irccf:mitigates irccf:T0811_DataFromInformationRepositories,
        irccf:T0852_ScreenCapture,
        irccf:T0882_TheftOfOperationalInformation,
        irccf:T0893_DataFromLocalSystem .

irccf:GDPR a irccf:Regulation ;
    rdfs:label "GDPR" ;
    irccf:imposesRequirement irccf:GDPR_Art__22_1,
        irccf:GDPR_Art__22_2__3,
