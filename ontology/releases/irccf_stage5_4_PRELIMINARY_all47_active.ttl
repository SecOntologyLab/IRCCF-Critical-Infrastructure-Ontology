irccf:MitigationAssertion_5212f36b_216f_4e32_8b64_3b4c94dfada5 a irccf:MITREMitigationAssertion ;
    dcterms:description """Enforce strong password requirements to prevent password brute force methods for lateral movement.
""" ;
