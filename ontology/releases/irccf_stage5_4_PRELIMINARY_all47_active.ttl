irccf:NetworkMonitoringControl a irccf:SecurityControl ;
    rdfs:label "Network monitoring control" ;
    irccf:belongsToStandard irccf:IEC_62443_3_3 ;
    irccf:mitigates irccf:T0830_AdversaryInTheMiddle,
        irccf:T0840_NetworkConnectionEnumeration,
        irccf:T0842_NetworkSniffing,
        irccf:T0869_StandardApplicationLayerProtocol,
        irccf:T0885_CommonlyUsedPort,
        irccf:T0887_WirelessSniffing .

irccf:NetworkSegmentationControl a irccf:SecurityControl ;
    rdfs:label "Network segmentation control (SR 5.1)" ;
    irccf:belongsToStandard irccf:IEC_62443_3_3 ;
    irccf:description "Network segmentation to limit lateral movement." ;
    irccf:mitigates irccf:T0843_ProgramDownload,
        irccf:T0866_ExploitationOfRemoteServices,
        irccf:T0867_LateralToolTransfer,
        irccf:T0884_ConnectionProxy .

irccf:OTSensor a irccf:AIEnabledSystem ;
    rdfs:label "AI-based OT Sensor" ;
    irccf:detects irccf:T0821_ModifyControllerTasking,
        irccf:T0830_AdversaryInTheMiddle,
        irccf:T0835_ManipulateIOImage,
        irccf:T0836_ModifyParameter,
        irccf:T0842_NetworkSniffing,
        irccf:T0855_UnauthorizedCommandMessage,
        irccf:T0856_SpoofReportingMessage,
        irccf:T0858_ChangeOperatingMode,
        irccf:T0866_ExploitationOfRemoteServices,
        irccf:T0878_AlarmSuppression ;
    irccf:usedInCaseStudy irccf:ICSCaseStudy .

irccf:Ontology a owl:Ontology ;
    rdfs:label "Integrated Regulatory Compliance and Cybersecurity Framework Ontology" .

irccf:PlatformProvider a irccf:Stakeholder .

irccf:ResourceAvailabilityControl a irccf:SecurityControl ;
    rdfs:label "Resource availability control (SR 7.1)" ;
    irccf:belongsToStandard irccf:IEC_62443_3_3 ;
    irccf:description "Denial of service protection and resource availability." ;
    irccf:mitigates irccf:T0814_DenialOfService,
        irccf:T0816_DeviceRestartShutdown,
        irccf:T0881_ServiceStop .

irccf:SystemIntegrityControl a irccf:SecurityControl ;
    rdfs:label "System integrity control (SR 3.4)" ;
    irccf:belongsToStandard irccf:IEC_62443_3_3 ;
    irccf:description "Software and information integrity verification." ;
    irccf:mitigates irccf:T0839_ModuleFirmware,
        irccf:T0851_Rootkit,
        irccf:T0857_SystemFirmware,
        irccf:T0873_ProjectFileInfection,
        irccf:T0889_ModifyProgram,
        irccf:T0895_AutorunImage .

irccf:T0805_BlockSerialCOM a irccf:HistoricalThreatTechnique ;
    rdfs:label "Block Serial COM" ;
    irccf:belongsToThreatModel irccf:MITRE_ATTACK_ICS ;
    irccf:mitreStatus "not active in ATT&CK ICS v19.2" .

irccf:T0837_LossOfProtection a irccf:ThreatTechnique ;
    rdfs:label "Loss of Protection" ;
    irccf:belongsToTactic irccf:TA0105_Impact ;
    irccf:belongsToThreatModel irccf:MITRE_ATTACK_ICS ;
    irccf:mitreAttackID "T0837" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:mitreSTIXID "attack-pattern--2bb4d762-bf4a-4bc3-9318-15cc6a354163" ;
    irccf:mitreStatus "active" .

irccf:UseControlAuthorization a irccf:SecurityControl ;
    rdfs:label "Use control authorization (SR 2.1)" ;
    irccf:belongsToStandard irccf:IEC_62443_3_3 ;
    irccf:description "Authorization enforcement for all users." ;
    irccf:mitigates irccf:T0807_CommandLineInterface,
        irccf:T0823_GraphicalUserInterface,
        irccf:T0871_ExecutionThroughAPI,
        irccf:T0890_ExploitationForPrivilegeEscalation .

