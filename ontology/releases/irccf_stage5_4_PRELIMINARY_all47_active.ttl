    irccf:technique irccf:T0860_WirelessCompromise .

irccf:MitigationAssertion_b363cbbb_679c_47e0_8ad0_af98ebf51e60 a irccf:MITREMitigationAssertion ;
    dcterms:description """Utilize strong cryptographic techniques and protocols to prevent eavesdropping on network communications.
""" ;
    dcterms:modified "2026-04-29T14:23:06.170Z" ;
    irccf:mitigation irccf:MITRE_M0808 ;
    irccf:mitigationSourceRecord "relationship--b363cbbb-679c-47e0-8ad0-af98ebf51e60" ;
