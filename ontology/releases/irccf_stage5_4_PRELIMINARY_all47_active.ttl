irccf:MITRE_M0802 a irccf:MITREMitigation ;
    rdfs:label "Communication Authenticity" ;
    dcterms:description "When communicating over an untrusted network, utilize secure network protocols that both authenticate the message sender and can verify its integrity. This can be done either through message authentication codes (MACs) or digital signatures, to detect spoofed network messages and unauthorized connections." ;
    dcterms:source <https://attack.mitre.org/mitigations/M0802/> ;
    irccf:hasMitigationAssertion irccf:MitigationAssertion_01c8cc53_dfd0_4afc_8df6_e57494bd9e24,
