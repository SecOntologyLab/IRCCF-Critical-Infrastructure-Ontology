irccf:MitigationAssertion_b9632b4d_43c3_4bfa_88e0_629245acb8eb a irccf:MITREMitigationAssertion ;
    dcterms:description """Ensure users and user groups have appropriate permissions for their roles through Identity and Access Management (IAM) controls to prevent misuse. Implement user accounts for each individual that may access the repositories for role enforcement and non-repudiation of actions.
""" ;
    dcterms:modified "2026-04-29T14:23:06.178Z" ;
