irccf:MitigationAssertion_c67e3535_69a9_4234_8170_4ad6efc632b7 a irccf:MITREMitigationAssertion ;
    dcterms:description """Implement continuous monitoring of vulnerability sources. Also, use automatic and manual code review tools. (Citation: OWASP)
""" ;
    dcterms:modified "2026-04-29T14:23:06.197Z" ;
    irccf:mitigation irccf:MITRE_M0916 ;
    irccf:mitigationSourceRecord "relationship--c67e3535-69a9-4234-8170-4ad6efc632b7" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0862_SupplyChainCompromise .

irccf:MitigationAssertion_c69eab3c_861c_45f5_8858_a595fcc7e6f6 a irccf:MITREMitigationAssertion ;
    dcterms:description """Network intrusion detection and prevention systems that use network signatures to identify traffic for specific adversary malware or unusual data transfer over known tools and protocols like FTP can be used to mitigate activity at the network level. Signatures are often for unique indicators within protocols and may be based on the specific obfuscation technique used by a particular adversary or tool and will likely be different across various malware families and versions. Adversaries will likely change tool C2 signatures over time or construct protocols in such a way as to avoid detection by common defensive tools. (Citation: Gardiner, J.,  Cova, M., Nagaraja, S February 2014)
""" ;
    dcterms:modified "2026-04-29T14:23:06.197Z" ;
    irccf:mitigation irccf:MITRE_M0931 ;
    irccf:mitigationSourceRecord "relationship--c69eab3c-861c-45f5-8858-a595fcc7e6f6" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0867_LateralToolTransfer .

irccf:MitigationAssertion_c78f497f_01c3_4efb_aa74_92b700b9c02b a irccf:MITREMitigationAssertion ;
    dcterms:description """When at rest, project files should be encrypted to prevent unauthorized changes.(Citation: National Institute of Standards and Technology April 2013)
""" ;
    dcterms:modified "2026-04-29T14:23:06.198Z" ;
    irccf:mitigation irccf:MITRE_M0941 ;
    irccf:mitigationSourceRecord "relationship--c78f497f-01c3-4efb-aa74-92b700b9c02b" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0873_ProjectFileInfection .

irccf:MitigationAssertion_c7aac6c9_da16_46e2_8cfa_dca07a0a7562 a irccf:MITREMitigationAssertion ;
    dcterms:description """Segment operational assets and their management devices based on their functional role within the process. Enabling more strict isolation to more critical control and operational information within the control environment. (Citation: Karen Scarfone; Paul Hoffman September 2009) (Citation: Keith Stouffer May 2015) (Citation: Department of Homeland Security September 2016) (Citation: Dwight Anderson 2014) 
""" ;
    dcterms:modified "2026-04-29T14:23:06.198Z" ;
    irccf:mitigation irccf:MITRE_M0930 ;
    irccf:mitigationSourceRecord "relationship--c7aac6c9-da16-46e2-8cfa-dca07a0a7562" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0861_PointAndTagIdentification .

irccf:MitigationAssertion_c7ae1f86_2029_4354_896b_baace526bf3c a irccf:MITREMitigationAssertion ;
    dcterms:description """Use host-based allowlists to prevent devices from accepting connections from unauthorized systems. For example, allowlists can be used to ensure devices can only connect with master stations or known management/engineering workstations.(Citation: Department of Homeland Security September 2016)
""" ;
    dcterms:modified "2026-04-29T14:23:06.198Z" ;
    irccf:mitigation irccf:MITRE_M0807 ;
    irccf:mitigationSourceRecord "relationship--c7ae1f86-2029-4354-896b-baace526bf3c" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1692_UnauthorizedMessage .

irccf:MitigationAssertion_c8a40335_90d6_496a_b4f9_1cc93d3fffc6 a irccf:MITREMitigationAssertion ;
    dcterms:description """A supply chain management program should include methods the assess the trustworthiness and technical maturity of a supplier, along with technical methods (e.g., code-signing, bill of materials) needed to validate the integrity of newly obtained devices and components. Develop procurement language that emphasizes the expectations for suppliers regarding the artifacts, audit records, and technical capabilities needed to validate the integrity of the devices supply chain. (Citation: Robert A. Martin January 2021)
""" ;
    dcterms:modified "2026-04-29T14:23:06.199Z" ;
    irccf:mitigation irccf:MITRE_M0817 ;
    irccf:mitigationSourceRecord "relationship--c8a40335-90d6-496a-b4f9-1cc93d3fffc6" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0862_SupplyChainCompromise .

irccf:MitigationAssertion_c8dd2735_bd04_4413_847d_316b77c6de19 a irccf:MITREMitigationAssertion ;
    dcterms:description "Network allowlists can be implemented through either host-based files or system host files to specify what external connections (e.g., IP address, MAC address, port, protocol) can be made from a device. Allowlist techniques that operate at the application layer (e.g., DNP3, Modbus, HTTP) are addressed in the [Filter Network Traffic](https://attack.mitre.org/mitigations/M0937) mitigation." ;
    dcterms:modified "2026-04-29T14:23:06.200Z" ;
    irccf:mitigation irccf:MITRE_M0807 ;
    irccf:mitigationSourceRecord "relationship--c8dd2735-bd04-4413-847d-316b77c6de19" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0884_ConnectionProxy .

irccf:MitigationAssertion_c9065f74_556d_4728_8072_f96642e70316 a irccf:MITREMitigationAssertion ;
    dcterms:description """Access Management technologies can help enforce authentication on critical remote service, examples include, but are not limited to, device management services (e.g., telnet, SSH), data access servers (e.g., HTTP, Historians), and HMI sessions (e.g., RDP, VNC).
""" ;
    dcterms:modified "2026-04-29T14:23:06.200Z" ;
    irccf:mitigation irccf:MITRE_M0801 ;
    irccf:mitigationSourceRecord "relationship--c9065f74-556d-4728-8072-f96642e70316" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0886_RemoteServices .

irccf:MitigationAssertion_c91514db_4e02_459e_9ff4_5092fdffb049 a irccf:MITREMitigationAssertion ;
    dcterms:description "Filter for protocols and payloads associated with program download activity to prevent unauthorized device configurations." ;
    dcterms:modified "2026-04-29T14:23:06.200Z" ;
    irccf:mitigation irccf:MITRE_M0937 ;
    irccf:mitigationSourceRecord "relationship--c91514db-4e02-459e-9ff4-5092fdffb049" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0843_002_OnlineEdit .

irccf:MitigationAssertion_c9395e2a_afaf_427c_bcb2_ae663d72c05c a irccf:MITREMitigationAssertion ;
    dcterms:description """Provide an alternative method for alarms to be reported in the event of a communication failure.
""" ;
    dcterms:modified "2026-04-29T14:23:06.200Z" ;
    irccf:mitigation irccf:MITRE_M0810 ;
    irccf:mitigationSourceRecord "relationship--c9395e2a-afaf-427c-bcb2-ae663d72c05c" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0878_AlarmSuppression .

irccf:MitigationAssertion_ca5c7ae7_5273_4888_bc50_183d6e200972 a irccf:MITREMitigationAssertion ;
    dcterms:description """Built-in browser sandboxes and application isolation may be used to contain web-based malware.
""" ;
    dcterms:modified "2026-04-29T14:23:06.202Z" ;
    irccf:mitigation irccf:MITRE_M0948 ;
    irccf:mitigationSourceRecord "relationship--ca5c7ae7-5273-4888-bc50-183d6e200972" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0817_DriveByCompromise .

irccf:MitigationAssertion_ca64a927_f050_41b3_80d3_93d22cdef26a a irccf:MITREMitigationAssertion ;
    dcterms:description """Ensure that unnecessary ports and services are closed to prevent risk of discovery and potential exploitation.
""" ;
    dcterms:modified "2026-04-29T14:23:06.202Z" ;
    irccf:mitigation irccf:MITRE_M0942 ;
    irccf:mitigationSourceRecord "relationship--ca64a927-f050-41b3-80d3-93d22cdef26a" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0885_CommonlyUsedPort .

irccf:MitigationAssertion_ca768c2a_0f14_471c_90a5_bce649e88d51 a irccf:MITREMitigationAssertion ;
    dcterms:description """Application denylists can be used to block automation protocol functions used to initiate device shutdowns or restarts, such as DNP3's 0x0D function code, or vulnerabilities that can be used to trigger device shutdowns (e.g., CVE-2014-9195, CVE-2015-5374).
""" ;
    dcterms:modified "2026-04-29T14:23:06.202Z" ;
    irccf:mitigation irccf:MITRE_M0937 ;
    irccf:mitigationSourceRecord "relationship--ca768c2a-0f14-471c-90a5-bce649e88d51" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0816_DeviceRestartShutdown .

irccf:MitigationAssertion_cae90fbb_ba0d_4a9a_9da3_b9f32ab1cd07 a irccf:MITREMitigationAssertion ;
    dcterms:description "Provide the ability to verify the integrity of programs downloaded on a controller. While techniques like CRCs and checksums are commonly used, they are not cryptographically secure and can be vulnerable to collisions. Preferably cryptographic hash functions (e.g., SHA-2, SHA-3) should be used.(Citation: IEC February 2019)" ;
    dcterms:modified "2026-04-29T14:23:06.202Z" ;
    irccf:mitigation irccf:MITRE_M0947 ;
    irccf:mitigationSourceRecord "relationship--cae90fbb-ba0d-4a9a-9da3-b9f32ab1cd07" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0843_002_OnlineEdit .

irccf:MitigationAssertion_cb30d507_edc6_4197_947c_7b3a6e395c0d a irccf:MITREMitigationAssertion ;
    dcterms:description """Utilize code signatures to verify the integrity and authenticity of programs downloaded to the device.
""" ;
    dcterms:modified "2026-04-29T14:23:06.203Z" ;
    irccf:mitigation irccf:MITRE_M0945 ;
    irccf:mitigationSourceRecord "relationship--cb30d507-edc6-4197-947c-7b3a6e395c0d" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0843_ProgramDownload .

irccf:MitigationAssertion_cb4d802e_df5b_4017_81dd_47f65fff23a3 a irccf:MITREMitigationAssertion ;
    dcterms:description """Encrypt any operational data with strong confidentiality requirements, including organizational trade-secrets, recipes, and other intellectual property (IP).
""" ;
    dcterms:modified "2026-04-29T14:23:06.203Z" ;
    irccf:mitigation irccf:MITRE_M0941 ;
    irccf:mitigationSourceRecord "relationship--cb4d802e-df5b-4017-81dd-47f65fff23a3" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0882_TheftOfOperationalInformation .

irccf:MitigationAssertion_cb6d67c0_33ba_4c49_ae70_d0e4f0f68794 a irccf:MITREMitigationAssertion ;
    dcterms:description "Retain cold-standby or replacement hardware of similar models to ensure continued operations of critical functions if the primary system is compromised or unavailable. (Citation: M. Rentschler and H. Heine)" ;
    dcterms:modified "2026-04-29T14:23:06.203Z" ;
    irccf:mitigation irccf:MITRE_M0811 ;
    irccf:mitigationSourceRecord "relationship--cb6d67c0-33ba-4c49-ae70-d0e4f0f68794" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0892_ChangeCredential .

irccf:MitigationAssertion_cb993689_bb59_4c96_b9fd_42cfcb92d76f a irccf:MITREMitigationAssertion ;
    dcterms:description "Check the integrity of the existing BIOS or EFI to determine if it is vulnerable to modification. Use Trusted Platform Module technology.(Citation: N/A) Move system's root of trust to hardware to prevent tampering with the SPI flash memory.(Citation: ESET Research Whitepapers September 2018) Technologies such as Intel Boot Guard can assist with this.(Citation: Intel)" ;
    dcterms:modified "2026-04-29T14:23:06.203Z" ;
    irccf:mitigation irccf:MITRE_M0946 ;
    irccf:mitigationSourceRecord "relationship--cb993689-bb59-4c96-b9fd-42cfcb92d76f" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1693_ModifyFirmware .

irccf:MitigationAssertion_cca191a1_3c50_4d4f_8f79_4247e58af610 a irccf:MITREMitigationAssertion ;
    dcterms:description """Use tools that restrict program execution via application control by attributes other than file name for common system and application utilities.
""" ;
    dcterms:modified "2026-04-29T14:23:06.205Z" ;
    irccf:mitigation irccf:MITRE_M0938 ;
    irccf:mitigationSourceRecord "relationship--cca191a1-3c50-4d4f-8f79-4247e58af610" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0849_Masquerading .

irccf:MitigationAssertion_cd645dbe_000a_43f9_86e6_622bb1ab1053 a irccf:MITREMitigationAssertion ;
    dcterms:description "Authenticate connections from software and devices to prevent unauthorized systems from accessing protected management functions." ;
    dcterms:modified "2026-04-29T14:23:06.206Z" ;
    irccf:mitigation irccf:MITRE_M0813 ;
    irccf:mitigationSourceRecord "relationship--cd645dbe-000a-43f9-86e6-622bb1ab1053" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0843_002_OnlineEdit .

irccf:MitigationAssertion_d03785b3_9b51_45f2_aff5_029555c53826 a irccf:MITREMitigationAssertion ;
    dcterms:description "Segment operational network and systems to restrict access to critical system functions to predetermined management systems.(Citation: Department of Homeland Security September 2016)" ;
    dcterms:modified "2026-04-29T14:23:06.210Z" ;
    irccf:mitigation irccf:MITRE_M0930 ;
    irccf:mitigationSourceRecord "relationship--d03785b3-9b51-45f2-aff5-029555c53826" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0843_003_ProgramAppend .

irccf:MitigationAssertion_d1445579_245b_4698_a7df_365379e0d36d a irccf:MITREMitigationAssertion ;
    dcterms:description """Check the integrity of the existing BIOS or EFI to determine if it is vulnerable to modification. Use Trusted Platform Module technology.(Citation: N/A) Move system's root of trust to hardware to prevent tampering with the SPI flash memory.(Citation: ESET Research Whitepapers September 2018) Technologies such as Intel Boot Guard can assist with this.(Citation: Intel)
""" ;
    dcterms:modified "2026-04-29T14:23:06.212Z" ;
    irccf:mitigation irccf:MITRE_M0946 ;
