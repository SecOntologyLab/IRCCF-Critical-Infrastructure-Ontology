    irccf:technique irccf:T0882_TheftOfOperationalInformation .

irccf:MitigationAssertion_698d7c50_daab_4087_a7b4_b2bc8dfd81a7 a irccf:MITREMitigationAssertion ;
    dcterms:description """Provide the ability to verify the integrity of controller tasking. While techniques like CRCs and checksums are commonly used, they are not cryptographically secure and can be vulnerable to collisions. Preferably cryptographic hash functions (e.g., SHA-2, SHA-3) should be used. (Citation: IEC February 2019)
""" ;
    dcterms:modified "2026-04-29T14:23:06.069Z" ;
    irccf:mitigation irccf:MITRE_M0947 ;
    irccf:mitigationSourceRecord "relationship--698d7c50-daab-4087-a7b4-b2bc8dfd81a7" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0821_ModifyControllerTasking .

irccf:MitigationAssertion_69f9597e_a47d_49bb_a182_376349f979ef a irccf:MITREMitigationAssertion ;
    dcterms:description "Provide an alternative method for sending critical commands message to outstations, this could include using radio/cell communication to send messages to a field technician that physically performs the control function." ;
    dcterms:modified "2026-04-29T14:23:06.069Z" ;
    irccf:mitigation irccf:MITRE_M0810 ;
    irccf:mitigationSourceRecord "relationship--69f9597e-a47d-49bb-a182-376349f979ef" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1691_BlockOperationalTechnologyMessage .

irccf:MitigationAssertion_6a314797_9105_44e3_be5f_41b817454daf a irccf:MITREMitigationAssertion ;
    dcterms:description "Protocols used for device management should authenticate all network messages to prevent unauthorized system changes." ;
    dcterms:modified "2026-04-29T14:23:06.070Z" ;
    irccf:mitigation irccf:MITRE_M0802 ;
    irccf:mitigationSourceRecord "relationship--6a314797-9105-44e3-be5f-41b817454daf" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0843_003_ProgramAppend .

irccf:MitigationAssertion_6ad39b3a_a962_457f_852c_be7fc615e22f a irccf:MITREMitigationAssertion ;
    dcterms:description """Take and store data backups from end user systems and critical servers. Ensure backup and storage systems are hardened and kept separate from the corporate network to prevent compromise.  Maintain and exercise incident response plans  (Citation: Department of Homeland Security October 2009), including the management of gold-copy back-up images and configurations for key systems to enable quick recovery and response from adversarial activities that impact control, view, or availability.
""" ;
    dcterms:modified "2026-04-29T14:23:06.070Z" ;
    irccf:mitigation irccf:MITRE_M0953 ;
    irccf:mitigationSourceRecord "relationship--6ad39b3a-a962-457f-852c-be7fc615e22f" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0827_LossOfControl .

irccf:MitigationAssertion_6b5d2643_b399_43aa_8ab1_7557a0446b07 a irccf:MITREMitigationAssertion ;
    dcterms:description """Only authorized personnel should be able to change settings for alarms.
""" ;
    dcterms:modified "2026-04-29T14:23:06.071Z" ;
    irccf:mitigation irccf:MITRE_M0800 ;
    irccf:mitigationSourceRecord "relationship--6b5d2643-b399-43aa-8ab1-7557a0446b07" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0838_ModifyAlarmSettings .

irccf:MitigationAssertion_6b5fd6d8_ef70_4896_b1a4_7b6c29c3a0d4 a irccf:MITREMitigationAssertion ;
    dcterms:description """All field controllers should restrict the modification of programs to only certain users (e.g., engineers, field technician), preferably through implementing a role-based access mechanism.
""" ;
    dcterms:modified "2026-04-29T14:23:06.071Z" ;
    irccf:mitigation irccf:MITRE_M0800 ;
    irccf:mitigationSourceRecord "relationship--6b5fd6d8-ef70-4896-b1a4-7b6c29c3a0d4" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0816_DeviceRestartShutdown .

irccf:MitigationAssertion_6bbb12c3_171d_45a5_a01b_a74b0c0704f0 a irccf:MITREMitigationAssertion ;
    dcterms:description "Perform integrity checks of firmware before uploading it on a device. Utilize cryptographic hashes to verify the firmware has not been tampered with by comparing it to a trusted hash of the firmware. This could be from trusted data sources (e.g., vendor site) or through a third-party verification service." ;
    dcterms:modified "2026-04-29T14:23:06.072Z" ;
    irccf:mitigation irccf:MITRE_M0947 ;
    irccf:mitigationSourceRecord "relationship--6bbb12c3-171d-45a5-a01b-a74b0c0704f0" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1693_ModifyFirmware .

irccf:MitigationAssertion_6be4cef2_3d54_4cd8_97df_8a8b37c03605 a irccf:MITREMitigationAssertion ;
    dcterms:description """Utilize central storage servers for critical operations where possible (e.g., historians) and keep remote backups. For outstations, use local redundant storage for event recorders. Have backup control system platforms, preferably as hot-standbys to respond immediately to data destruction events. (Citation: National Institute of Standards and Technology April 2013)
""" ;
    dcterms:modified "2026-04-29T14:23:06.072Z" ;
    irccf:mitigation irccf:MITRE_M0953 ;
