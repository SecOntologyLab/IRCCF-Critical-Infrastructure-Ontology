    irccf:technique irccf:T0860_WirelessCompromise .

irccf:MitigationAssertion_b3b24837_83ed_46c5_ba80_66a832c7072e a irccf:MITREMitigationAssertion ;
    dcterms:description """All devices or systems changes, including all administrative functions, should require authentication. Consider using access management technologies to enforce authorization on all management interface access attempts, especially when the device does not inherently provide strong authentication and authorization functions.
""" ;
    dcterms:modified "2026-04-29T14:23:06.171Z" ;
    irccf:mitigation irccf:MITRE_M0801 ;
    irccf:mitigationSourceRecord "relationship--b3b24837-83ed-46c5-ba80-66a832c7072e" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0800_ActivateFirmwareUpdateMode .

irccf:MitigationAssertion_b47dbc50_fd8f_4e5b_bb3d_e93b68bf5497 a irccf:MITREMitigationAssertion ;
    dcterms:description """Limit access to network infrastructure and resources that can be used to reshape traffic or otherwise produce AiTM conditions.
""" ;
    dcterms:modified "2026-04-29T14:23:06.172Z" ;
    irccf:mitigation irccf:MITRE_M0947 ;
    irccf:mitigationSourceRecord "relationship--b47dbc50-fd8f-4e5b-bb3d-e93b68bf5497" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0830_AdversaryInTheMiddle .

irccf:MitigationAssertion_b48a9fea_26a5_473c_9a5d_fcc3531e1fd3 a irccf:MITREMitigationAssertion ;
    dcterms:description "Develop and publish policies that define acceptable information to be stored on local systems." ;
    dcterms:modified "2026-04-29T14:23:06.172Z" ;
    irccf:mitigation irccf:MITRE_M0917 ;
    irccf:mitigationSourceRecord "relationship--b48a9fea-26a5-473c-9a5d-fcc3531e1fd3" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0893_DataFromLocalSystem .

irccf:MitigationAssertion_b58f623d_c61f_46e8_b356_09af226ba9ad a irccf:MITREMitigationAssertion ;
    dcterms:description """Perform integrity checks of firmware before uploading it on a device. Utilize cryptographic hashes to verify the firmware has not been tampered with by comparing it to a trusted hash of the firmware. This could be from trusted data sources (e.g., vendor site) or through a third-party verification service.
""" ;
    dcterms:modified "2026-04-29T14:23:06.173Z" ;
    irccf:mitigation irccf:MITRE_M0947 ;
    irccf:mitigationSourceRecord "relationship--b58f623d-c61f-46e8-b356-09af226ba9ad" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1693_002_ModuleFirmware .

irccf:MitigationAssertion_b5bb5ec3_aa3c_4734_8425_4be80c5658a9 a irccf:MITREMitigationAssertion ;
    dcterms:description """This technique may not be effectively mitigated against, consider controls for assets and processes that lead to the use of this technique.
""" ;
    dcterms:modified "2026-04-29T14:23:06.173Z" ;
    irccf:mitigation irccf:MITRE_M0816 ;
    irccf:mitigationSourceRecord "relationship--b5bb5ec3-aa3c-4734-8425-4be80c5658a9" ;
