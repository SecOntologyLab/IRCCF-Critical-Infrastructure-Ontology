irccf:MitigationAssertion_a22fabd2_836e_4141_9219_c76cc10138ec a irccf:MITREMitigationAssertion ;
    dcterms:description """Use host-based allowlists to prevent devices from accepting connections from unauthorized systems. For example, allowlists can be used to ensure devices can only connect with master stations or known management/engineering workstations. (Citation: Department of Homeland Security September 2016)
""" ;
    dcterms:modified "2026-04-29T14:23:06.146Z" ;
    irccf:mitigation irccf:MITRE_M0807 ;
    irccf:mitigationSourceRecord "relationship--a22fabd2-836e-4141-9219-c76cc10138ec" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0868_DetectOperatingMode .

irccf:MitigationAssertion_a23297f1_58b9_48f4_8289_e81c34d9a522 a irccf:MITREMitigationAssertion ;
    dcterms:description "All field controllers should require users to authenticate for all remote or local management sessions. The authentication mechanisms should also support [Account Use Policies](https://attack.mitre.org/mitigations/M0936), [Password Policies](https://attack.mitre.org/mitigations/M0927), and [User Account Management](https://attack.mitre.org/mitigations/M0918)." ;
    dcterms:modified "2026-04-29T14:23:06.146Z" ;
    irccf:mitigation irccf:MITRE_M0804 ;
    irccf:mitigationSourceRecord "relationship--a23297f1-58b9-48f4-8289-e81c34d9a522" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0843_001_DownloadAll .

irccf:MitigationAssertion_a3971be9_7bef_4663_b6c3_3cffc418f76b a irccf:MITREMitigationAssertion ;
    dcterms:description "Authenticate connections from software and devices to prevent unauthorized systems from accessing protected management functions." ;
    dcterms:modified "2026-04-29T14:23:06.148Z" ;
    irccf:mitigation irccf:MITRE_M0813 ;
    irccf:mitigationSourceRecord "relationship--a3971be9-7bef-4663-b6c3-3cffc418f76b" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1693_ModifyFirmware .

irccf:MitigationAssertion_a3df8609_d9c4_4ef0_9a58_8d7155fba4f7 a irccf:MITREMitigationAssertion ;
    dcterms:description """Protocols used for device management should authenticate all network messages to prevent unauthorized system changes.
""" ;
    dcterms:modified "2026-04-29T14:23:06.148Z" ;
    irccf:mitigation irccf:MITRE_M0802 ;
    irccf:mitigationSourceRecord "relationship--a3df8609-d9c4-4ef0-9a58-8d7155fba4f7" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1693_001_SystemFirmware .

irccf:MitigationAssertion_a3fb7c3c_7064_43d2_849c_2a5893583de9 a irccf:MITREMitigationAssertion ;
    dcterms:description "Segment operational networks to isolate critical systems and devices that do not require broad network access." ;
    dcterms:modified "2026-04-29T14:23:06.148Z" ;
    irccf:mitigation irccf:MITRE_M0930 ;
    irccf:mitigationSourceRecord "relationship--a3fb7c3c-7064-43d2-849c-2a5893583de9" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1695_002_Ethernet .

irccf:MitigationAssertion_a61fa979_f701_4dbe_b040_397b152ac14f a irccf:MITREMitigationAssertion ;
    dcterms:description "Authenticate all access to field controllers before authorizing access to, or modification of, a device's state, logic, or programs. Centralized authentication techniques can help manage the large number of field controller accounts needed across the ICS." ;
    dcterms:modified "2026-04-29T14:23:06.151Z" ;
    irccf:mitigation irccf:MITRE_M0801 ;
    irccf:mitigationSourceRecord "relationship--a61fa979-f701-4dbe-b040-397b152ac14f" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0843_002_OnlineEdit .

irccf:MitigationAssertion_a6ebd61b_7845_4694_9860_2e8998f2841f a irccf:MITREMitigationAssertion ;
    dcterms:description """Utilize network allowlists to restrict unnecessary connections to network devices (e.g., comm servers, serial to ethernet converters) and services, especially in cases when devices have limits on the number of simultaneous sessions they support.
""" ;
    dcterms:modified "2026-04-29T14:23:06.152Z" ;
    irccf:mitigation irccf:MITRE_M0807 ;
    irccf:mitigationSourceRecord "relationship--a6ebd61b-7845-4694-9860-2e8998f2841f" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1691_001_CommandMessage .

irccf:MitigationAssertion_a717ccc7_0fe6_4a83_951f_5a89037ed927 a irccf:MITREMitigationAssertion ;
    dcterms:description "Take and store data backups from end user systems and critical servers. Ensure backup and storage systems are hardened and kept separate from the corporate network to prevent compromise.  Maintain and exercise incident response plans  (Citation: Department of Homeland Security October 2009), including the management of gold-copy back-up images and configurations for key systems to enable quick recovery and response from adversarial activities that impact control, view, or availability." ;
    dcterms:modified "2026-04-29T14:23:06.153Z" ;
    irccf:mitigation irccf:MITRE_M0953 ;
    irccf:mitigationSourceRecord "relationship--a717ccc7-0fe6-4a83-951f-5a89037ed927" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0892_ChangeCredential .

irccf:MitigationAssertion_a78e727c_8e42_448c_beb4_463804e18be0 a irccf:MITREMitigationAssertion ;
    dcterms:description """Minimize permissions and access for service accounts to limit impact of exploitation. (Citation: Keith Stouffer May 2015)
""" ;
    dcterms:modified "2026-04-29T14:23:06.153Z" ;
    irccf:mitigation irccf:MITRE_M0926 ;
    irccf:mitigationSourceRecord "relationship--a78e727c-8e42-448c-beb4-463804e18be0" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0866_ExploitationOfRemoteServices .

irccf:MitigationAssertion_a7caa7f2_cfb9_4fc9_ae8d_49349b6c260f a irccf:MITREMitigationAssertion ;
    dcterms:description """All field controllers should restrict the download of programs, including online edits and program appends, to only certain users (e.g., engineers, field technician), preferably through implementing a role-based access mechanism.
""" ;
    dcterms:modified "2026-04-29T14:23:06.154Z" ;
    irccf:mitigation irccf:MITRE_M0800 ;
    irccf:mitigationSourceRecord "relationship--a7caa7f2-cfb9-4fc9-ae8d-49349b6c260f" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0843_ProgramDownload .

irccf:MitigationAssertion_a7fbe555_a61b_4b93_bfb2_8e0dd0d6323e a irccf:MITREMitigationAssertion ;
    dcterms:description """Consider utilizing jump boxes for external remote access. Additionally, dynamic account management may be used to easily remove accounts when not in use.
""" ;
    dcterms:modified "2026-04-29T14:23:06.154Z" ;
    irccf:mitigation irccf:MITRE_M0918 ;
    irccf:mitigationSourceRecord "relationship--a7fbe555-a61b-4b93-bfb2-8e0dd0d6323e" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0822_ExternalRemoteServices .

irccf:MitigationAssertion_a847aa03_ea56_47d1_8f4e_f9e0dd9707a0 a irccf:MITREMitigationAssertion ;
    dcterms:description """Consider removal of remote services which are not regularly in use, or only enabling them when required (e.g., vendor remote access). Ensure all external remote access point (e.g., jump boxes, VPN concentrator) are configured with least functionality, especially the removal of unnecessary services. (Citation: Department of Homeland Security September 2016)
""" ;
    dcterms:modified "2026-04-29T14:23:06.154Z" ;
    irccf:mitigation irccf:MITRE_M0942 ;
    irccf:mitigationSourceRecord "relationship--a847aa03-ea56-47d1-8f4e-f9e0dd9707a0" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0822_ExternalRemoteServices .

irccf:MitigationAssertion_a8563939_14f9_4790_a8bb_6e984e3ad7ac a irccf:MITREMitigationAssertion ;
    dcterms:description "Authenticate connections from software and devices to prevent unauthorized systems from accessing protected management functions." ;
