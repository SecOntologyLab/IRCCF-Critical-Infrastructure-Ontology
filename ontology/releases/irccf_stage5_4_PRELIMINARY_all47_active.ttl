irccf:MitigationAssertion_842a2b85_4e77_4eb6_99e1_c4a231aadf48 a irccf:MITREMitigationAssertion ;
    dcterms:description """Network allowlists can be implemented through either host-based files or system host files to specify what external connections (e.g., IP address, MAC address, port, protocol) can be made from a device.
""" ;
