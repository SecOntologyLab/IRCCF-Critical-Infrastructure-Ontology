irccf:MitigationAssertion_4211c12a_57cf_4ebb_910a_6af7aa09cf34 a irccf:MITREMitigationAssertion ;
    dcterms:description """All communication sessions to remote services should be authenticated to prevent unauthorized access.
""" ;
    dcterms:modified "2026-04-29T14:23:06.015Z" ;
    irccf:mitigation irccf:MITRE_M0813 ;
    irccf:mitigationSourceRecord "relationship--4211c12a-57cf-4ebb-910a-6af7aa09cf34" ;
