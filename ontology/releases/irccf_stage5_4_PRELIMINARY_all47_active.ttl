irccf:MitigationAssertion_af20f409_05ed_42c3_ae3e_09b047b84875 a irccf:MITREMitigationAssertion ;
    dcterms:description "All field controllers should require that user authenticate for all remote or local management sessions. The authentication mechanisms should also support Account Use Policies, Password Policies, and User Account Management." ;
    dcterms:modified "2026-04-29T14:23:06.163Z" ;
    irccf:mitigation irccf:MITRE_M0804 ;
    irccf:mitigationSourceRecord "relationship--af20f409-05ed-42c3-ae3e-09b047b84875" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0836_ModifyParameter .

irccf:MitigationAssertion_af5c41cb_063d_42a9_ad54_833bd65477d0 a irccf:MITREMitigationAssertion ;
    dcterms:description "Ensure systems and devices have an alternative method for communicating in the event that Ethernet communication channels become unavailable." ;
    dcterms:modified "2026-04-29T14:23:06.164Z" ;
    irccf:mitigation irccf:MITRE_M0810 ;
    irccf:mitigationSourceRecord "relationship--af5c41cb-063d-42a9-ad54-833bd65477d0" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1695_002_Ethernet .

irccf:MitigationAssertion_af861c3e_966c_49aa_86c4_a76102977d16 a irccf:MITREMitigationAssertion ;
    dcterms:description "Provide the ability to verify the integrity of programs downloaded on a controller. While techniques like CRCs and checksums are commonly used, they are not cryptographically secure and can be vulnerable to collisions. Preferably cryptographic hash functions (e.g., SHA-2, SHA-3) should be used.(Citation: IEC February 2019)" ;
    dcterms:modified "2026-04-29T14:23:06.164Z" ;
    irccf:mitigation irccf:MITRE_M0947 ;
    irccf:mitigationSourceRecord "relationship--af861c3e-966c-49aa-86c4-a76102977d16" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0843_003_ProgramAppend .

irccf:MitigationAssertion_afb0b60e_e604_4b96_abb9_57fdce4e5108 a irccf:MITREMitigationAssertion ;
    dcterms:description """Hot-standbys in diverse locations can ensure continued operations if the primarily system is compromised or unavailable. At the network layer, protocols such as the Parallel Redundancy Protocol can be used to simultaneously use redundant and diverse communication over a local network. (Citation: M. Rentschler and H. Heine)
""" ;
    dcterms:modified "2026-04-29T14:23:06.165Z" ;
    irccf:mitigation irccf:MITRE_M0811 ;
    irccf:mitigationSourceRecord "relationship--afb0b60e-e604-4b96-abb9-57fdce4e5108" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0826_LossOfAvailability .

irccf:MitigationAssertion_afd63145_6033_49e4_ad43_d0b35fa5ed88 a irccf:MITREMitigationAssertion ;
    dcterms:description """Protocols used for device management should authenticate all network messages to prevent unauthorized system changes.
""" ;
    dcterms:modified "2026-04-29T14:23:06.165Z" ;
    irccf:mitigation irccf:MITRE_M0802 ;
    irccf:mitigationSourceRecord "relationship--afd63145-6033-49e4-ad43-d0b35fa5ed88" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0800_ActivateFirmwareUpdateMode .

irccf:MitigationAssertion_b13417ea_d8da_497f_818f_d2d90562039a a irccf:MITREMitigationAssertion ;
    dcterms:description """Network intrusion detection and prevention systems that can identify traffic patterns indicative of AiTM activity can be used to mitigate activity at the network level.
""" ;
    dcterms:modified "2026-04-29T14:23:06.167Z" ;
    irccf:mitigation irccf:MITRE_M0931 ;
    irccf:mitigationSourceRecord "relationship--b13417ea-d8da-497f-818f-d2d90562039a" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0830_AdversaryInTheMiddle .

irccf:MitigationAssertion_b1768154_221c_48be_ab2b_549ec1eddafb a irccf:MITREMitigationAssertion ;
    dcterms:description """Segment operational assets and their management devices based on their functional role within the process. Enabling more strict isolation to more critical control and operational information within the control environment. (Citation: Karen Scarfone; Paul Hoffman September 2009) (Citation: Keith Stouffer May 2015) (Citation: Department of Homeland Security September 2016) (Citation: Dwight Anderson 2014) 
""" ;
    dcterms:modified "2026-04-29T14:23:06.167Z" ;
    irccf:mitigation irccf:MITRE_M0930 ;
    irccf:mitigationSourceRecord "relationship--b1768154-221c-48be-ab2b-549ec1eddafb" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0878_AlarmSuppression .

irccf:MitigationAssertion_b1d993d5_9e7e_4043_a651_07c7b5ad5a6b a irccf:MITREMitigationAssertion ;
    dcterms:description """If a link is being visited by a user, network intrusion prevention systems and systems designed to scan and remove malicious downloads can be used to block activity.
""" ;
    dcterms:modified "2026-04-29T14:23:06.168Z" ;
    irccf:mitigation irccf:MITRE_M0931 ;
    irccf:mitigationSourceRecord "relationship--b1d993d5-9e7e-4043-a651-07c7b5ad5a6b" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0863_UserExecution .

irccf:MitigationAssertion_b2defaaf_625d_416e_8a9d_8be6d89bacdc a irccf:MITREMitigationAssertion ;
    dcterms:description """ICS environments typically have more statically defined devices, therefore minimize the use of both IT discovery protocols (e.g., DHCP, LLDP) and discovery functions in automation protocols.(Citation: D. Parsons and D. Wylie September 2019)(Citation: Colin Gray) Examples of automation protocols with discovery capabilities include OPC UA Device Discovery(Citation: Josh Rinaldi April 2016), BACnet(Citation: Aditya K Sood July 2019), and Ethernet/IP.(Citation: Langner November 2018)
""" ;
    dcterms:modified "2026-04-29T14:23:06.169Z" ;
    irccf:mitigation irccf:MITRE_M0814 ;
    irccf:mitigationSourceRecord "relationship--b2defaaf-625d-416e-8a9d-8be6d89bacdc" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0846_RemoteSystemDiscovery .

irccf:MitigationAssertion_b2e10e48_8bd9_472a_9c6f_1d38650e8df1 a irccf:MITREMitigationAssertion ;
    dcterms:description """Techniques can include (i) reducing transmission power on wireless signals, (ii) adjusting antenna gain to prevent extensions beyond organizational boundaries, and (iii) employing RF shielding techniques to block excessive signal propagation. (Citation: DHS  National Urban Security Technology Laboratory April 2019)
""" ;
    dcterms:modified "2026-04-29T14:23:06.169Z" ;
    irccf:mitigation irccf:MITRE_M0806 ;
