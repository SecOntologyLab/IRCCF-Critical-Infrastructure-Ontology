    dcterms:description """Segment operational network and systems to restrict access to critical system functions to predetermined management systems.(Citation: Department of Homeland Security September 2016)
""" ;
    dcterms:modified "2026-04-29T14:23:06.160Z" ;
    irccf:mitigation irccf:MITRE_M0930 ;
    irccf:mitigationSourceRecord "relationship--ac8d2d28-5fdc-44d6-9e5a-8e5560b3f91f" ;
    irccf:mitreDataVersion "ICS v19.2" ;
