irccf:MitigationAssertion_dc35c44a_a90c_48a1_8811_af2618216e42 a irccf:MITREMitigationAssertion ;
    dcterms:description """Use strong multi-factor authentication for remote service accounts to mitigate an adversary's ability to leverage stolen credentials. Be aware of multi-factor authentication interception techniques for some implementations.
""" ;
    dcterms:modified "2026-04-29T14:23:06.226Z" ;
    irccf:mitigation irccf:MITRE_M0932 ;
    irccf:mitigationSourceRecord "relationship--dc35c44a-a90c-48a1-8811-af2618216e42" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0822_ExternalRemoteServices .

irccf:MitigationAssertion_dda89758_9d0b_446d_b594_85acc7f9cb90 a irccf:MITREMitigationAssertion ;
    dcterms:description """Take and store data backups from end user systems and critical servers. Ensure backup and storage systems are hardened and kept separate from the corporate network to prevent compromise.  Maintain and exercise incident response plans  (Citation: Department of Homeland Security October 2009), including the management of gold-copy back-up images and configurations for key systems to enable quick recovery and response from adversarial activities that impact control, view, or availability.
""" ;
    dcterms:modified "2026-04-29T14:23:06.228Z" ;
    irccf:mitigation irccf:MITRE_M0953 ;
    irccf:mitigationSourceRecord "relationship--dda89758-9d0b-446d-b594-85acc7f9cb90" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0828_LossOfProductivityAndRevenue .

irccf:MitigationAssertion_dded2d68_35c7_42c4_af10_efe7731673e3 a irccf:MITREMitigationAssertion ;
    dcterms:description """All APIs on remote systems or local processes should require the authentication of users before executing any code or system changes.
""" ;
    dcterms:modified "2026-04-29T14:23:06.228Z" ;
    irccf:mitigation irccf:MITRE_M0804 ;
    irccf:mitigationSourceRecord "relationship--dded2d68-35c7-42c4-af10-efe7731673e3" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0871_ExecutionThroughAPI .

irccf:MitigationAssertion_de370506_01db_412f_a6fb_57c4014de788 a irccf:MITREMitigationAssertion ;
    dcterms:description "Utilize code signatures to verify the integrity and authenticity of programs downloaded to the device." ;
    dcterms:modified "2026-04-29T14:23:06.228Z" ;
    irccf:mitigation irccf:MITRE_M0945 ;
    irccf:mitigationSourceRecord "relationship--de370506-01db-412f-a6fb-57c4014de788" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0843_002_OnlineEdit .

irccf:MitigationAssertion_de6a1c7c_8d90_4f5c_8618_7c7ea9a2da89 a irccf:MITREMitigationAssertion ;
    dcterms:description "All devices or systems changes, including all administrative functions, should require authentication. Consider using access management technologies to enforce authorization on all management interface access attempts, especially when the device does not inherently provide strong authentication and authorization functions." ;
    dcterms:modified "2026-04-29T14:23:06.228Z" ;
    irccf:mitigation irccf:MITRE_M0801 ;
    irccf:mitigationSourceRecord "relationship--de6a1c7c-8d90-4f5c-8618-7c7ea9a2da89" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1693_ModifyFirmware .

irccf:MitigationAssertion_df6da4ec_cbe8_4f93_a41f_3726a9491938 a irccf:MITREMitigationAssertion ;
    dcterms:description """Statically defined ARP entries can prevent manipulation and sniffing of switched network traffic, as some AiTM techniques depend on sending spoofed ARP messages to manipulate network host's dynamic ARP tables.
""" ;
    dcterms:modified "2026-04-29T14:23:06.230Z" ;
    irccf:mitigation irccf:MITRE_M0814 ;
    irccf:mitigationSourceRecord "relationship--df6da4ec-cbe8-4f93-a41f-3726a9491938" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0842_NetworkSniffing .

irccf:MitigationAssertion_e09e253c_fd28_49ae_988e_1f80d769e8b8 a irccf:MITREMitigationAssertion ;
    dcterms:description """Prevent the use of unsigned executables, such as installers and scripts.
""" ;
    dcterms:modified "2026-04-29T14:23:06.231Z" ;
    irccf:mitigation irccf:MITRE_M0945 ;
    irccf:mitigationSourceRecord "relationship--e09e253c-fd28-49ae-988e-1f80d769e8b8" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0863_UserExecution .

irccf:MitigationAssertion_e0d101cc_1284_4e88_82d6_227fe5d19d8a a irccf:MITREMitigationAssertion ;
    dcterms:description """Update software regularly by employing patch management for internal enterprise endpoints and servers.
""" ;
    dcterms:modified "2026-04-29T14:23:06.232Z" ;
    irccf:mitigation irccf:MITRE_M0951 ;
    irccf:mitigationSourceRecord "relationship--e0d101cc-1284-4e88-82d6-227fe5d19d8a" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0866_ExploitationOfRemoteServices .

irccf:MitigationAssertion_e1653814_74cd_4885_906f_b3af88452917 a irccf:MITREMitigationAssertion ;
    dcterms:description "Use host-based allowlists to prevent devices from accepting connections from unauthorized systems. For example, allowlists can be used to ensure devices can only connect with master stations or known management/engineering workstations.(Citation: Department of Homeland Security September 2016)" ;
    dcterms:modified "2026-04-29T14:23:06.232Z" ;
    irccf:mitigation irccf:MITRE_M0807 ;
    irccf:mitigationSourceRecord "relationship--e1653814-74cd-4885-906f-b3af88452917" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0843_001_DownloadAll .

irccf:MitigationAssertion_e5afc447_a241_4773_9a8a_3d6fd205d926 a irccf:MITREMitigationAssertion ;
    dcterms:description """Utilize exploit protection to prevent activities which may be exploited through malicious web sites.
""" ;
    dcterms:modified "2026-04-29T14:23:06.238Z" ;
    irccf:mitigation irccf:MITRE_M0950 ;
    irccf:mitigationSourceRecord "relationship--e5afc447-a241-4773-9a8a-3d6fd205d926" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0817_DriveByCompromise .

irccf:MitigationAssertion_e607bb66_e53f_4684_b3f1_36a997e27d01 a irccf:MITREMitigationAssertion ;
    dcterms:description """Protection devices should have minimal digital components to prevent exposure to related adversarial techniques. Examples include interlocks, rupture disks, release valves, etc. (Citation: A G Foord, W G Gulland, C R Howard, T Kellacher, W H Smith 2004) 
""" ;
    dcterms:modified "2026-04-29T14:23:06.238Z" ;
    irccf:mitigation irccf:MITRE_M0805 ;
    irccf:mitigationSourceRecord "relationship--e607bb66-e53f-4684-b3f1-36a997e27d01" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0879_DamageToProperty .

irccf:MitigationAssertion_e62235fe_0546_4755_ad01_fedce306ef89 a irccf:MITREMitigationAssertion ;
    dcterms:description "Segment operational assets and their management devices based on their functional role within the process. Enabling more strict isolation to more critical control and operational information within the control environment.(Citation: Karen Scarfone; Paul Hoffman September 2009)(Citation: Keith Stouffer May 2015)(Citation: Department of Homeland Security September 2016)(Citation: Dwight Anderson 2014) " ;
    dcterms:modified "2026-04-29T14:23:06.238Z" ;
    irccf:mitigation irccf:MITRE_M0930 ;
    irccf:mitigationSourceRecord "relationship--e62235fe-0546-4755-ad01-fedce306ef89" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1692_UnauthorizedMessage .

irccf:MitigationAssertion_e627461f_f2cc_427b_8896_72db160bca24 a irccf:MITREMitigationAssertion ;
    dcterms:description "Implement network allowlists to minimize network access to only authorized hosts." ;
    dcterms:modified "2026-04-29T14:23:06.238Z" ;
    irccf:mitigation irccf:MITRE_M0807 ;
    irccf:mitigationSourceRecord "relationship--e627461f-f2cc-427b-8896-72db160bca24" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1695_BlockCommunications .

irccf:MitigationAssertion_e6be2fb4_3815_4e52_8dec_2aed1dc3b7cf a irccf:MITREMitigationAssertion ;
    dcterms:description """All field controllers should restrict the modification of parameter values to only certain users (e.g., engineers, field technician), preferably through implementing a role-based access mechanism. They should also restrict online edits and enable write protection for parameters. 
""" ;
    dcterms:modified "2026-04-29T14:23:06.239Z" ;
    irccf:mitigation irccf:MITRE_M0800 ;
    irccf:mitigationSourceRecord "relationship--e6be2fb4-3815-4e52-8dec-2aed1dc3b7cf" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0836_ModifyParameter .

irccf:MitigationAssertion_e6e0ef82_2cb6_43fe_8f4a_b9e4d5a57b13 a irccf:MITREMitigationAssertion ;
    dcterms:description """Segment operational network and systems to restrict access to critical system functions to predetermined management systems. (Citation: Department of Homeland Security September 2016)
""" ;
    dcterms:modified "2026-04-29T14:23:06.239Z" ;
    irccf:mitigation irccf:MITRE_M0930 ;
    irccf:mitigationSourceRecord "relationship--e6e0ef82-2cb6-43fe-8f4a-b9e4d5a57b13" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0858_ChangeOperatingMode .

irccf:MitigationAssertion_e70d04d1_51e3_4d43_b3dd_111daeea14f9 a irccf:MITREMitigationAssertion ;
    dcterms:description """The encryption of firmware should be considered to prevent adversaries from identifying possible vulnerabilities within the firmware.
""" ;
    dcterms:modified "2026-04-29T14:23:06.239Z" ;
    irccf:mitigation irccf:MITRE_M0941 ;
    irccf:mitigationSourceRecord "relationship--e70d04d1-51e3-4d43-b3dd-111daeea14f9" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1693_002_ModuleFirmware .

irccf:MitigationAssertion_e7564f70_9f10_4135_9803_842cd3d2a02f a irccf:MITREMitigationAssertion ;
    dcterms:description """Patch the BIOS and EFI as necessary.
""" ;
    dcterms:modified "2026-04-29T14:23:06.240Z" ;
    irccf:mitigation irccf:MITRE_M0951 ;
    irccf:mitigationSourceRecord "relationship--e7564f70-9f10-4135-9803-842cd3d2a02f" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1693_001_SystemFirmware .

irccf:MitigationAssertion_e767c178_e4b2_490a_b544_bb1b2d6c7de4 a irccf:MITREMitigationAssertion ;
    dcterms:description """Application isolation will limit the other processes and system features an exploited target can access. Examples of built in features are software restriction policies, AppLocker for Windows, and SELinux or AppArmor for Linux.
""" ;
    dcterms:modified "2026-04-29T14:23:06.240Z" ;
    irccf:mitigation irccf:MITRE_M0948 ;
    irccf:mitigationSourceRecord "relationship--e767c178-e4b2-490a-b544-bb1b2d6c7de4" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0819_ExploitPublicFacingApplication .

irccf:MitigationAssertion_e852e64c_b5e0_4e7f_a189_bbc7aa7932c7 a irccf:MITREMitigationAssertion ;
    dcterms:description """Hot-standbys in diverse locations can ensure continued operations if the primarily system are compromised or unavailable. At the network layer, protocols such as the Parallel Redundancy Protocol can be used to simultaneously use redundant and diverse communication over a local network. (Citation: M. Rentschler and H. Heine)
""" ;
    dcterms:modified "2026-04-29T14:23:06.241Z" ;
    irccf:mitigation irccf:MITRE_M0811 ;
    irccf:mitigationSourceRecord "relationship--e852e64c-b5e0-4e7f-a189-bbc7aa7932c7" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0815_DenialOfView .

irccf:MitigationAssertion_e8af0b34_4a67_4966_a34a_c4d1b346ea15 a irccf:MITREMitigationAssertion ;
    dcterms:description """All devices or systems changes, including all administrative functions, should require authentication. Consider using access management technologies to enforce authorization on all management interface access attempts, especially when the device does not inherently provide strong authentication and authorization functions.
""" ;
    dcterms:modified "2026-04-29T14:23:06.242Z" ;
    irccf:mitigation irccf:MITRE_M0801 ;
    irccf:mitigationSourceRecord "relationship--e8af0b34-4a67-4966-a34a-c4d1b346ea15" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0816_DeviceRestartShutdown .

irccf:MitigationAssertion_e8eaac2d_a4bf_408f_b24f_14471db7059b a irccf:MITREMitigationAssertion ;
    dcterms:description """Minimize permissions and access for service accounts to limit the information that may be impacted by malicious users or software. (Citation: National Institute of Standards and Technology April 2013)
""" ;
    dcterms:modified "2026-04-29T14:23:06.242Z" ;
    irccf:mitigation irccf:MITRE_M0926 ;
    irccf:mitigationSourceRecord "relationship--e8eaac2d-a4bf-408f-b24f-14471db7059b" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0809_DataDestruction .

irccf:MitigationAssertion_ea1ba63b_d0e1_4d1b_a098_72ce2c44a44a a irccf:MITREMitigationAssertion ;
    dcterms:description "Protocols used for control functions should provide authenticity through MAC functions or digital signatures. If not, utilize bump-in-the-wire devices or VPNs to enforce communication authenticity between devices that are not capable of supporting this (e.g., legacy controllers, RTUs)." ;
    dcterms:modified "2026-04-29T14:23:06.244Z" ;
    irccf:mitigation irccf:MITRE_M0802 ;
    irccf:mitigationSourceRecord "relationship--ea1ba63b-d0e1-4d1b-a098-72ce2c44a44a" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1692_UnauthorizedMessage .

irccf:MitigationAssertion_ea817c7a_9424_4204_90a5_6f8fb86037be a irccf:MITREMitigationAssertion ;
    dcterms:description """Configure features related to account use like login attempt lockouts, specific login times, and password strength requirements as examples. Consider these features as they relate to assets which may impact safety and availability. (Citation: Keith Stouffer May 2015)
""" ;
    dcterms:modified "2026-04-29T14:23:06.244Z" ;
    irccf:mitigation irccf:MITRE_M0936 ;
    irccf:mitigationSourceRecord "relationship--ea817c7a-9424-4204-90a5-6f8fb86037be" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0859_ValidAccounts .

irccf:MitigationAssertion_eaa0b30e_1dea_4dad_9a1e_33da933a8158 a irccf:MITREMitigationAssertion ;
    dcterms:description """Devices should verify that firmware has been properly signed by the vendor before allowing installation.
""" ;
    dcterms:modified "2026-04-29T14:23:06.244Z" ;
    irccf:mitigation irccf:MITRE_M0945 ;
    irccf:mitigationSourceRecord "relationship--eaa0b30e-1dea-4dad-9a1e-33da933a8158" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1693_001_SystemFirmware .

irccf:MitigationAssertion_eac550b4_3bd2_4309_8b37_b797dd0bd8a7 a irccf:MITREMitigationAssertion ;
    dcterms:description """Segment operational network and systems to restrict access to critical system functions to predetermined management systems. (Citation: Department of Homeland Security September 2016)
""" ;
    dcterms:modified "2026-04-29T14:23:06.245Z" ;
    irccf:mitigation irccf:MITRE_M0930 ;
    irccf:mitigationSourceRecord "relationship--eac550b4-3bd2-4309-8b37-b797dd0bd8a7" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0868_DetectOperatingMode .

irccf:MitigationAssertion_eba478bb_7b76_4889_b82c_eda10826ffcb a irccf:MITREMitigationAssertion ;
    dcterms:description """Unauthorized connections can be prevented by statically defining the hosts and ports used for automation protocol connections.
""" ;
    dcterms:modified "2026-04-29T14:23:06.246Z" ;
    irccf:mitigation irccf:MITRE_M0814 ;
    irccf:mitigationSourceRecord "relationship--eba478bb-7b76-4889-b82c-eda10826ffcb" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1691_001_CommandMessage .

irccf:MitigationAssertion_ebc34374_2dee_4dc1_b0b7_f31ae94dab11 a irccf:MITREMitigationAssertion ;
    dcterms:description """Protocols used for device management should authenticate all network messages to prevent unauthorized system changes.
""" ;
    dcterms:modified "2026-04-29T14:23:06.246Z" ;
    irccf:mitigation irccf:MITRE_M0802 ;
    irccf:mitigationSourceRecord "relationship--ebc34374-2dee-4dc1-b0b7-f31ae94dab11" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0843_ProgramDownload .

irccf:MitigationAssertion_ec105f62_2552_41fa_8b07_619dc1bf9b19 a irccf:MITREMitigationAssertion ;
    dcterms:description """Authenticate all access to field controllers before authorizing access to, or modification of, a device's state, logic, or programs. Centralized authentication techniques can help manage the large number of field controller accounts needed across the ICS.
""" ;
    dcterms:modified "2026-04-29T14:23:06.246Z" ;
    irccf:mitigation irccf:MITRE_M0801 ;
    irccf:mitigationSourceRecord "relationship--ec105f62-2552-41fa-8b07-619dc1bf9b19" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0843_ProgramDownload .

irccf:MitigationAssertion_eccbcd3d_ea6e_4e9d_aa15_7b6e0909b6e0 a irccf:MITREMitigationAssertion ;
    dcterms:description "Perform inline allowlisting of automation protocol commands to prevent devices from sending unauthorized command or reporting messages. Allow/denylist techniques need to be designed with sufficient accuracy to prevent the unintended blocking of valid messages." ;
    dcterms:modified "2026-04-29T14:23:06.247Z" ;
    irccf:mitigation irccf:MITRE_M0937 ;
    irccf:mitigationSourceRecord "relationship--eccbcd3d-ea6e-4e9d-aa15-7b6e0909b6e0" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1692_UnauthorizedMessage .

irccf:MitigationAssertion_ecf39e19_439f_4e9a_97c2_673ce4eb0a1a a irccf:MITREMitigationAssertion ;
    dcterms:description """Provide operators with redundant, out-of-band communication to support monitoring and control of the operational processes, especially when recovering from a network outage  (Citation: National Institute of Standards and Technology April 2013). Out-of-band communication should utilize diverse systems and technologies to minimize common failure modes and vulnerabilities within the communications infrastructure. For example, wireless networks (e.g., 3G, 4G) can be used to provide diverse and redundant delivery of data.
""" ;
    dcterms:modified "2026-04-29T14:23:06.247Z" ;
    irccf:mitigation irccf:MITRE_M0810 ;
    irccf:mitigationSourceRecord "relationship--ecf39e19-439f-4e9a-97c2-673ce4eb0a1a" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0829_LossOfView .

irccf:MitigationAssertion_ee89466e_0655_4217_844d_fb8ea4f76247 a irccf:MITREMitigationAssertion ;
    dcterms:description """Filter for protocols and payloads associated with firmware activation or updating activity.
""" ;
    dcterms:modified "2026-04-29T14:23:06.250Z" ;
    irccf:mitigation irccf:MITRE_M0937 ;
    irccf:mitigationSourceRecord "relationship--ee89466e-0655-4217-844d-fb8ea4f76247" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0800_ActivateFirmwareUpdateMode .

irccf:MitigationAssertion_eecca3e7_4db5_40d4_b04c_13f84701acb3 a irccf:MITREMitigationAssertion ;
    dcterms:description """Take and store data backups from end user systems and critical servers. Ensure backup and storage systems are hardened and kept separate from the corporate network to prevent compromise.  Maintain and exercise incident response plans  (Citation: Department of Homeland Security October 2009), including the management of gold-copy back-up images and configurations for key systems to enable quick recovery and response from adversarial activities that impact control, view, or availability.
""" ;
    dcterms:modified "2026-04-29T14:23:06.250Z" ;
    irccf:mitigation irccf:MITRE_M0953 ;
    irccf:mitigationSourceRecord "relationship--eecca3e7-4db5-40d4-b04c-13f84701acb3" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0829_LossOfView .

irccf:MitigationAssertion_eed98f8e_3eb9_4238_9acf_c2a0be136e87 a irccf:MITREMitigationAssertion ;
    dcterms:description "Devices that allow remote management of firmware should require authentication before allowing any changes. The authentication mechanisms should also support [Account Use Policies](https://attack.mitre.org/mitigations/M0936), [Password Policies](https://attack.mitre.org/mitigations/M0927), and [User Account Management](https://attack.mitre.org/mitigations/M0918)." ;
    dcterms:modified "2026-04-29T14:23:06.250Z" ;
    irccf:mitigation irccf:MITRE_M0804 ;
    irccf:mitigationSourceRecord "relationship--eed98f8e-3eb9-4238-9acf-c2a0be136e87" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T1693_002_ModuleFirmware .

irccf:MitigationAssertion_eeeaa0d4_0ca0_468e_ae13_43ab7aba61b4 a irccf:MITREMitigationAssertion ;
    dcterms:description """Consider configuration and use of a network-wide authentication service such as Active Directory, LDAP, or RADIUS capabilities which can be found in ICS devices. (Citation: Keith Stouffer May 2015) (Citation: Schweitzer Engineering Laboratories August 2015)
""" ;
    dcterms:modified "2026-04-29T14:23:06.250Z" ;
    irccf:mitigation irccf:MITRE_M0915 ;
    irccf:mitigationSourceRecord "relationship--eeeaa0d4-0ca0-468e-ae13-43ab7aba61b4" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0859_ValidAccounts .

irccf:MitigationAssertion_eeeff03f_7436_4f76_8591_42075e6647d4 a irccf:MITREMitigationAssertion ;
    dcterms:description """All field controllers should restrict operating mode changes to only required authenticated users (e.g., engineers, field technicians), preferably through implementing a role-based access mechanism. Further, physical mechanisms (e.g., keys) can also be used to limit unauthorized operating mode changes.
""" ;
    dcterms:modified "2026-04-29T14:23:06.250Z" ;
    irccf:mitigation irccf:MITRE_M0800 ;
    irccf:mitigationSourceRecord "relationship--eeeff03f-7436-4f76-8591-42075e6647d4" ;
    irccf:mitreDataVersion "ICS v19.2" ;
    irccf:technique irccf:T0858_ChangeOperatingMode .

irccf:MitigationAssertion_efb80069_e4be_4055_bd34_06d1376b4601 a irccf:MITREMitigationAssertion ;
    dcterms:description """Access Management technologies can be used to enforce authorization policies and decisions, especially when existing field devices do not provide capabilities to support user identification and authentication. (Citation: McCarthy, J et al. July 2018) These technologies typically utilize an in-line network device or gateway system to prevent access to unauthenticated users, while also integrating with an authentication service to first verify user credentials.
""" ;
    dcterms:modified "2026-04-29T14:23:06.251Z" ;
    irccf:mitigation irccf:MITRE_M0801 ;
    irccf:mitigationSourceRecord "relationship--efb80069-e4be-4055-bd34-06d1376b4601" ;
