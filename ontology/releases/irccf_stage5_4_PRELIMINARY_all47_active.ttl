irccf:AIAct_Art__14_1__4 a irccf:RegulatoryRequirement ;
    rdfs:label "Human oversight by design"@en ;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng> ;
    irccf:applicabilityTrigger "High-risk AI system under applicable rules"@en ;
    irccf:evidenceClassification "Direct obligation"@en ;
    irccf:inventoryDescription "Design and develop high-risk AI systems for effective oversight by natural persons, including capabilities to monitor, interpret, override or interrupt as appropriate"@en ;
    irccf:mappingReviewStatus "Candidate—verify paragraph and applicability before RDF inclusion"@en ;
    irccf:regulatedActor "Providers of high-risk AI systems"@en ;
    irccf:requirementTheme "Human oversight by design"@en ;
    irccf:scopeCaveat "Distinct from GDPR Article 22; Art. 14(5) addresses special biometrics case"@en ;
    irccf:sourceProvision "Art. 14(1)-(4)"@en .

irccf:AIEnabledSystem a owl:Class ;
    rdfs:subClassOf irccf:Asset .

irccf:CRA_Art__14 a irccf:RegulatoryRequirement ;
    rdfs:label "Vulnerability/incident reporting"@en ;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng> ;
    irccf:applicabilityTrigger "Specific CRA reporting triggers and statutory phased implementation"@en ;
    irccf:evidenceClassification "Direct obligation"@en ;
    irccf:inventoryDescription "Notify designated authorities of actively exploited vulnerabilities and severe incidents affecting product security under staged time requirements"@en ;
    irccf:mappingReviewStatus "Candidate—verify paragraph and applicability before RDF inclusion"@en ;
    irccf:regulatedActor "Manufacturers"@en ;
    irccf:requirementTheme "Vulnerability/incident reporting"@en ;
    irccf:scopeCaveat "Not interchangeable with NIS2 or GDPR reporting"@en ;
    irccf:sourceProvision "Art. 14"@en .

