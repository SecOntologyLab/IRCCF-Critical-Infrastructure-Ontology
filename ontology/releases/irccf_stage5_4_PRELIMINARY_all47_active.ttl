irccf:MitigationAssertion_69576d3c_d0e8_459e_9f2e_0b9c560b2e04 a irccf:MITREMitigationAssertion ;
    dcterms:description """Example mitigations could include minimizing its distribution/storage or obfuscating the information (e.g., facility coverterms, codenames).  In many cases this information may be necessary to support critical engineering, maintenance, or operational functions, therefore, it may not be feasible to implement.
""" ;
    dcterms:modified "2026-04-29T14:23:06.068Z" ;
    irccf:mitigation irccf:MITRE_M0809 ;
    irccf:mitigationSourceRecord "relationship--69576d3c-d0e8-459e-9f2e-0b9c560b2e04" ;
