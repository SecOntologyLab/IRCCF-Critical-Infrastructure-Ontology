@prefix irccf: <https://purl.org/ircc-framework#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

irccf:Ontology a owl:Ontology ;
    rdfs:label "Integrated Regulatory Compliance and Cybersecurity Framework Ontology" .

### ===================================================================
### CORE CLASSES
### ===================================================================

irccf:Regulation a owl:Class .
irccf:RegulatoryRequirement a owl:Class .
irccf:CybersecurityFramework a owl:Class .
irccf:FrameworkFunction a owl:Class .
irccf:TechnicalStandard a owl:Class .
irccf:SecurityControl a owl:Class .
irccf:ThreatModel a owl:Class .
irccf:Tactic a owl:Class .
irccf:ThreatTechnique a owl:Class .
irccf:Asset a owl:Class .
irccf:AIEnabledSystem a owl:Class ;
    rdfs:subClassOf irccf:Asset .
irccf:Stakeholder a owl:Class .
irccf:ProcessingActivity a owl:Class .
irccf:ComplianceMeasure a owl:Class .
irccf:CaseStudy a owl:Class .

### ===================================================================
### OBJECT PROPERTIES
### ===================================================================

irccf:imposesRequirement a owl:ObjectProperty ;
    rdfs:domain irccf:Regulation ;
    rdfs:range irccf:RegulatoryRequirement .

irccf:appliesTo a owl:ObjectProperty ;
    rdfs:domain irccf:RegulatoryRequirement ;
    rdfs:range irccf:Asset .

irccf:mapsToFunction a owl:ObjectProperty ;
    rdfs:comment "Links requirements, tactics, or controls to NIST CSF functions." .

irccf:implementedBy a owl:ObjectProperty ;
    rdfs:domain irccf:RegulatoryRequirement ;
    rdfs:range irccf:SecurityControl .

irccf:mitigates a owl:ObjectProperty ;
    rdfs:domain irccf:SecurityControl ;
    rdfs:range irccf:ThreatTechnique .

irccf:detects a owl:ObjectProperty ;
    rdfs:domain irccf:Asset ;
    rdfs:range irccf:ThreatTechnique .

irccf:supportsComplianceWith a owl:ObjectProperty .

irccf:belongsToFramework a owl:ObjectProperty ;
    rdfs:domain irccf:FrameworkFunction ;
    rdfs:range irccf:CybersecurityFramework .

irccf:belongsToStandard a owl:ObjectProperty ;
    rdfs:domain irccf:SecurityControl ;
    rdfs:range irccf:TechnicalStandard .

irccf:belongsToThreatModel a owl:ObjectProperty ;
    rdfs:comment "Links tactics or techniques to a threat model." .

irccf:belongsToTactic a owl:ObjectProperty ;
    rdfs:domain irccf:ThreatTechnique ;
    rdfs:range irccf:Tactic .

irccf:usedInCaseStudy a owl:ObjectProperty .
irccf:involvesProcessing a owl:ObjectProperty .
irccf:performedBy a owl:ObjectProperty .
irccf:governsProcessing a owl:ObjectProperty .

### Datatype Property

irccf:description a owl:DatatypeProperty ;
    rdfs:range xsd:string .

### ===================================================================
### REGULATIONS
### ===================================================================

irccf:GDPR a irccf:Regulation ;
    rdfs:label "GDPR" .

irccf:NIS2 a irccf:Regulation ;
    rdfs:label "NIS2 Directive" .

irccf:AIAct a irccf:Regulation ;
    rdfs:label "EU AI Act" .

irccf:CRA a irccf:Regulation ;
    rdfs:label "Cyber Resilience Act" .

### ===================================================================
### FRAMEWORKS, STANDARDS, THREAT MODELS
### ===================================================================

irccf:NIST_CSF_2_0 a irccf:CybersecurityFramework ;
    rdfs:label "NIST CSF 2.0" .

irccf:IEC_62443_3_3 a irccf:TechnicalStandard ;
    rdfs:label "IEC 62443-3-3" .

irccf:MITRE_ATTACK_ICS a irccf:ThreatModel ;
    rdfs:label "MITRE ATT&CK for ICS" .

### ===================================================================
### NIST CSF 2.0 FUNCTIONS (complete set of six)
### ===================================================================

irccf:Govern a irccf:FrameworkFunction ;
    rdfs:label "Govern" ;
    irccf:belongsToFramework irccf:NIST_CSF_2_0 .

irccf:Identify a irccf:FrameworkFunction ;
    rdfs:label "Identify" ;
    irccf:belongsToFramework irccf:NIST_CSF_2_0 .

irccf:Protect a irccf:FrameworkFunction ;
    rdfs:label "Protect" ;
    irccf:belongsToFramework irccf:NIST_CSF_2_0 .

irccf:Detect a irccf:FrameworkFunction ;
    rdfs:label "Detect" ;
    irccf:belongsToFramework irccf:NIST_CSF_2_0 .

irccf:Respond a irccf:FrameworkFunction ;
    rdfs:label "Respond" ;
    irccf:belongsToFramework irccf:NIST_CSF_2_0 .

irccf:Recover a irccf:FrameworkFunction ;
    rdfs:label "Recover" ;
    irccf:belongsToFramework irccf:NIST_CSF_2_0 .

### ===================================================================
### REGULATORY REQUIREMENTS
### ===================================================================

irccf:DataMinimization a irccf:RegulatoryRequirement ;
    rdfs:label "Data minimization requirement" ;
    irccf:mapsToFunction irccf:Protect ;
    irccf:description "Personal data must be limited to what is necessary." .

irccf:IncidentReporting a irccf:RegulatoryRequirement ;
    rdfs:label "Incident reporting requirement" ;
    irccf:mapsToFunction irccf:Respond .

irccf:HumanOversight a irccf:RegulatoryRequirement ;
    rdfs:label "Human oversight requirement" ;
    irccf:mapsToFunction irccf:Detect .

irccf:SecurityByDesign a irccf:RegulatoryRequirement ;
    rdfs:label "Security by design requirement" ;
    irccf:mapsToFunction irccf:Protect .

irccf:RiskManagement a irccf:RegulatoryRequirement ;
    rdfs:label "Risk management requirement" ;
    irccf:mapsToFunction irccf:Identify ;
    irccf:description "Organizations must identify and manage cybersecurity risks." .

irccf:VulnerabilityHandling a irccf:RegulatoryRequirement ;
    rdfs:label "Vulnerability handling requirement" ;
    irccf:mapsToFunction irccf:Protect ;
    irccf:description "Products with digital elements must have vulnerability handling processes." .

irccf:SupplyChainSecurity a irccf:RegulatoryRequirement ;
    rdfs:label "Supply chain security requirement" ;
    irccf:mapsToFunction irccf:Govern ;
    irccf:description "Organizations must manage cybersecurity risks in supply chains." .

irccf:BusinessContinuity a irccf:RegulatoryRequirement ;
    rdfs:label "Business continuity requirement" ;
    irccf:mapsToFunction irccf:Recover ;
    irccf:description "Organizations must ensure continuity of essential services." .

irccf:AccessControl a irccf:RegulatoryRequirement ;
    rdfs:label "Access control requirement" ;
    irccf:mapsToFunction irccf:Protect ;
    irccf:description "Appropriate access control policies and procedures." .

irccf:TransparencyObligation a irccf:RegulatoryRequirement ;
    rdfs:label "Transparency obligation" ;
    irccf:mapsToFunction irccf:Govern ;
    irccf:description "AI systems must provide transparency regarding logic involved." .

### ===================================================================
### REGULATION → REQUIREMENT LINKS
### ===================================================================

irccf:GDPR irccf:imposesRequirement irccf:DataMinimization .
irccf:GDPR irccf:imposesRequirement irccf:HumanOversight .
irccf:GDPR irccf:imposesRequirement irccf:TransparencyObligation .

irccf:NIS2 irccf:imposesRequirement irccf:IncidentReporting .
irccf:NIS2 irccf:imposesRequirement irccf:RiskManagement .
irccf:NIS2 irccf:imposesRequirement irccf:SupplyChainSecurity .
irccf:NIS2 irccf:imposesRequirement irccf:BusinessContinuity .
irccf:NIS2 irccf:imposesRequirement irccf:AccessControl .

irccf:AIAct irccf:imposesRequirement irccf:HumanOversight .
irccf:AIAct irccf:imposesRequirement irccf:SecurityByDesign .
irccf:AIAct irccf:imposesRequirement irccf:RiskManagement .
irccf:AIAct irccf:imposesRequirement irccf:TransparencyObligation .

irccf:CRA irccf:imposesRequirement irccf:SecurityByDesign .
irccf:CRA irccf:imposesRequirement irccf:VulnerabilityHandling .

### ===================================================================
### MITRE ATT&CK FOR ICS — TACTIC LAYER (12 tactics)
### ===================================================================
### Each tactic is mapped to one or more NIST CSF 2.0 functions,
### establishing the bridge between the threat model and the
### organizational cybersecurity governance framework.
### ===================================================================

irccf:TA0108_InitialAccess a irccf:Tactic ;
    rdfs:label "Initial Access" ;
    irccf:description "Techniques used to gain an initial foothold within an ICS environment." ;
    irccf:belongsToThreatModel irccf:MITRE_ATTACK_ICS ;
    irccf:mapsToFunction irccf:Protect .

irccf:TA0104_Execution a irccf:Tactic ;
    rdfs:label "Execution" ;
    irccf:description "Techniques that result in adversary-controlled code running on a local or remote system." ;
    irccf:belongsToThreatModel irccf:MITRE_ATTACK_ICS ;
    irccf:mapsToFunction irccf:Protect , irccf:Detect .

irccf:TA0110_Persistence a irccf:Tactic ;
    rdfs:label "Persistence" ;
    irccf:description "Techniques used to maintain access to ICS environments across restarts or credential changes." ;
    irccf:belongsToThreatModel irccf:MITRE_ATTACK_ICS ;
    irccf:mapsToFunction irccf:Protect , irccf:Detect .

irccf:TA0111_PrivilegeEscalation a irccf:Tactic ;
    rdfs:label "Privilege Escalation" ;
    irccf:description "Techniques used to gain higher-level permissions on a system or network." ;
    irccf:belongsToThreatModel irccf:MITRE_ATTACK_ICS ;
    irccf:mapsToFunction irccf:Protect .

irccf:TA0103_Evasion a irccf:Tactic ;
    rdfs:label "Evasion" ;
    irccf:description "Techniques used to avoid detection throughout a compromise." ;
    irccf:belongsToThreatModel irccf:MITRE_ATTACK_ICS ;
    irccf:mapsToFunction irccf:Detect .

irccf:TA0102_Discovery a irccf:Tactic ;
    rdfs:label "Discovery" ;
    irccf:description "Techniques used to gain knowledge about the system and internal network." ;
    irccf:belongsToThreatModel irccf:MITRE_ATTACK_ICS ;
    irccf:mapsToFunction irccf:Detect , irccf:Identify .

irccf:TA0109_LateralMovement a irccf:Tactic ;
    rdfs:label "Lateral Movement" ;
    irccf:description "Techniques used to move through the ICS environment." ;
    irccf:belongsToThreatModel irccf:MITRE_ATTACK_ICS ;
    irccf:mapsToFunction irccf:Protect , irccf:Detect .

irccf:TA0100_Collection a irccf:Tactic ;
    rdfs:label "Collection" ;
    irccf:description "Techniques used to gather data of interest and domain knowledge." ;
    irccf:belongsToThreatModel irccf:MITRE_ATTACK_ICS ;
    irccf:mapsToFunction irccf:Detect , irccf:Protect .

irccf:TA0101_CommandAndControl a irccf:Tactic ;
    rdfs:label "Command and Control" ;
    irccf:description "Techniques used to communicate with systems under adversary control." ;
    irccf:belongsToThreatModel irccf:MITRE_ATTACK_ICS ;
    irccf:mapsToFunction irccf:Detect , irccf:Protect .

irccf:TA0107_InhibitResponseFunction a irccf:Tactic ;
    rdfs:label "Inhibit Response Function" ;
    irccf:description "Techniques that prevent safety, protection, and quality assurance functions from responding to a failure, hazard, or unsafe state." ;
    irccf:belongsToThreatModel irccf:MITRE_ATTACK_ICS ;
    irccf:mapsToFunction irccf:Respond , irccf:Recover , irccf:Detect .

irccf:TA0106_ImpairProcessControl a irccf:Tactic ;
    rdfs:label "Impair Process Control" ;
    irccf:description "Techniques that manipulate, disable, or damage physical control processes." ;
    irccf:belongsToThreatModel irccf:MITRE_ATTACK_ICS ;
    irccf:mapsToFunction irccf:Detect , irccf:Respond .

irccf:TA0105_Impact a irccf:Tactic ;
    rdfs:label "Impact" ;
    irccf:description "Techniques used to disrupt, deny, degrade, or destroy ICS systems and data." ;
    irccf:belongsToThreatModel irccf:MITRE_ATTACK_ICS ;
    irccf:mapsToFunction irccf:Respond , irccf:Recover .

