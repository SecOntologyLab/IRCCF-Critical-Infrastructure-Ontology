irccf:appliesTo a owl:ObjectProperty ;
    rdfs:domain irccf:RegulatoryRequirement ;
    rdfs:range irccf:Asset .

irccf:belongsToFramework a owl:ObjectProperty ;
    rdfs:domain irccf:FrameworkFunction ;
    rdfs:range irccf:CybersecurityFramework .

irccf:belongsToStandard a owl:ObjectProperty ;
    rdfs:domain irccf:SecurityControl ;
    rdfs:range irccf:TechnicalStandard .

irccf:belongsToTactic a owl:ObjectProperty ;
    rdfs:domain irccf:ThreatTechnique ;
    rdfs:range irccf:Tactic .

irccf:belongsToThreatModel a owl:ObjectProperty ;
    rdfs:comment "Links tactics or techniques to a threat model." .

irccf:description a owl:DatatypeProperty ;
    rdfs:range xsd:string .

irccf:detects a owl:ObjectProperty ;
    rdfs:domain irccf:Asset ;
    rdfs:range irccf:ThreatTechnique .

irccf:governsProcessing a owl:ObjectProperty .

irccf:hasSubtechnique a owl:ObjectProperty .

irccf:implementedBy a owl:ObjectProperty ;
    rdfs:domain irccf:RegulatoryRequirement ;
    rdfs:range irccf:SecurityControl .

irccf:imposesRequirement a owl:ObjectProperty ;
    rdfs:domain irccf:Regulation ;
    rdfs:range irccf:RegulatoryRequirement .

irccf:involvesProcessing a owl:ObjectProperty .

irccf:mapsToFunction a owl:ObjectProperty ;
    rdfs:comment "Links requirements, tactics, or controls to NIST CSF functions." .

irccf:mitigates a owl:ObjectProperty ;
    rdfs:domain irccf:SecurityControl ;
    rdfs:range irccf:ThreatTechnique .

irccf:mitreAttackID a owl:DatatypeProperty .

irccf:mitreDataVersion a owl:DatatypeProperty .

irccf:mitreSTIXID a owl:DatatypeProperty .

irccf:mitreStatus a owl:DatatypeProperty .

irccf:performedBy a owl:ObjectProperty .

irccf:subtechniqueOf a owl:ObjectProperty .

irccf:supportsComplianceWith a owl:ObjectProperty .

irccf:usedInCaseStudy a owl:ObjectProperty .

irccf:AIEnabledSystem a owl:Class ;
    rdfs:subClassOf irccf:Asset .

irccf:AccessControl a irccf:RegulatoryRequirement ;
    rdfs:label "Access control requirement" ;
    irccf:appliesTo irccf:OTSensor ;
    irccf:description "Appropriate access control policies and procedures." ;
    irccf:implementedBy irccf:AccessControlEnforcement,
        irccf:UseControlAuthorization ;
    irccf:mapsToFunction irccf:Protect .

irccf:AccessControlEnforcement a irccf:SecurityControl ;
    rdfs:label "Access control enforcement (SR 1.1)" ;
    irccf:belongsToStandard irccf:IEC_62443_3_3 ;
    irccf:description "Human user identification and authentication." ;
    irccf:mitigates irccf:T0812_DefaultCredentials,
        irccf:T0822_ExternalRemoteServices,
        irccf:T0859_ValidAccounts,
        irccf:T0886_RemoteServices,
        irccf:T0891_HardcodedCredentials,
        irccf:T0892_ChangeCredential .

irccf:BackupRecoveryControl a irccf:SecurityControl ;
    rdfs:label "Backup and recovery control (SR 7.3)" ;
    irccf:belongsToStandard irccf:IEC_62443_3_3 ;
    irccf:description "System backup and recovery capabilities." ;
    irccf:mitigates irccf:T0809_DataDestruction,
        irccf:T0826_LossOfAvailability .

irccf:BusinessContinuity a irccf:RegulatoryRequirement ;
    rdfs:label "Business continuity requirement" ;
    irccf:appliesTo irccf:OTSensor ;
    irccf:description "Organizations must ensure continuity of essential services." ;
    irccf:implementedBy irccf:BackupRecoveryControl,
        irccf:ResourceAvailabilityControl ;
    irccf:mapsToFunction irccf:Recover .

irccf:CTICaseStudy a irccf:CaseStudy .

irccf:CTIPlatform a irccf:Asset ;
    rdfs:label "CTI sharing platform" ;
    irccf:involvesProcessing irccf:ThreatSharing ;
    irccf:usedInCaseStudy irccf:CTICaseStudy .

irccf:CriticalInfrastructureOperator a irccf:Stakeholder .

irccf:DataConfidentialityControl a irccf:SecurityControl ;
    rdfs:label "Data confidentiality control (SR 4.1)" ;
    irccf:belongsToStandard irccf:IEC_62443_3_3 ;
    irccf:description "Information confidentiality protection." ;
    irccf:mitigates irccf:T0811_DataFromInformationRepositories,
        irccf:T0852_ScreenCapture,
        irccf:T0882_TheftOfOperationalInformation,
        irccf:T0893_DataFromLocalSystem .

irccf:DataMinimization a irccf:RegulatoryRequirement ;
    rdfs:label "Data minimization requirement" ;
    irccf:appliesTo irccf:OTSensor ;
    irccf:description "Personal data must be limited to what is necessary." ;
    irccf:governsProcessing irccf:ThreatSharing ;
    irccf:implementedBy irccf:DataConfidentialityControl,
        irccf:NetworkMonitoringControl ;
    irccf:mapsToFunction irccf:Protect .

irccf:ICSCaseStudy a irccf:CaseStudy .

irccf:IncidentReporting a irccf:RegulatoryRequirement ;
    rdfs:label "Incident reporting requirement" ;
    irccf:appliesTo irccf:CTIPlatform,
        irccf:OTSensor ;
    irccf:implementedBy irccf:AuditLoggingControl ;
    irccf:mapsToFunction irccf:Respond .

irccf:ProcessingActivity a owl:Class .

irccf:ResourceAvailabilityControl a irccf:SecurityControl ;
    rdfs:label "Resource availability control (SR 7.1)" ;
    irccf:belongsToStandard irccf:IEC_62443_3_3 ;
    irccf:description "Denial of service protection and resource availability." ;
    irccf:mitigates irccf:T0814_DenialOfService,
        irccf:T0816_DeviceRestartShutdown,
        irccf:T0881_ServiceStop .

irccf:SupplyChainSecurity a irccf:RegulatoryRequirement ;
    rdfs:label "Supply chain security requirement" ;
    irccf:description "Organizations must manage cybersecurity risks in supply chains." ;
    irccf:implementedBy irccf:SystemIntegrityControl ;
    irccf:mapsToFunction irccf:Govern .

irccf:T0803_BlockCommandMessage a irccf:HistoricalThreatTechnique ;
    rdfs:label "Block Command Message" ;
