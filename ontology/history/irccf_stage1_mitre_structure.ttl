@prefix irccf: <https://purl.org/ircc-framework#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

irccf:AIAct a irccf:Regulation ;
    rdfs:label "EU AI Act" ;
    irccf:imposesRequirement irccf:HumanOversight,
        irccf:RiskManagement,
        irccf:SecurityByDesign,
        irccf:TransparencyObligation .

irccf:CRA a irccf:Regulation ;
    rdfs:label "Cyber Resilience Act" ;
    irccf:imposesRequirement irccf:SecurityByDesign,
        irccf:VulnerabilityHandling .

irccf:CTIAnalysisProvider a irccf:Stakeholder .

irccf:CommunicationIntegrityControl a irccf:SecurityControl ;
    rdfs:label "Communication integrity control (SR 3.1)" ;
    irccf:belongsToStandard irccf:IEC_62443_3_3 ;
    irccf:description "Communication integrity protection." ;
    irccf:mitigates irccf:T0803_BlockCommandMessage,
        irccf:T0804_BlockReportingMessage,
        irccf:T0830_AdversaryInTheMiddle,
        irccf:T0848_RogueMaster .

irccf:ComplianceMeasure a owl:Class .

irccf:GDPR a irccf:Regulation ;
    rdfs:label "GDPR" ;
    irccf:imposesRequirement irccf:DataMinimization,
        irccf:HumanOversight,
        irccf:TransparencyObligation .

irccf:NIS2 a irccf:Regulation ;
    rdfs:label "NIS2 Directive" ;
    irccf:imposesRequirement irccf:AccessControl,
        irccf:BusinessContinuity,
        irccf:IncidentReporting,
        irccf:RiskManagement,
        irccf:SupplyChainSecurity .

irccf:NetworkSegmentationControl a irccf:SecurityControl ;
    rdfs:label "Network segmentation control (SR 5.1)" ;
    irccf:belongsToStandard irccf:IEC_62443_3_3 ;
    irccf:description "Network segmentation to limit lateral movement." ;
    irccf:mitigates irccf:T0843_ProgramDownload,
        irccf:T0866_ExploitationOfRemoteServices,
        irccf:T0867_LateralToolTransfer,
        irccf:T0884_ConnectionProxy .

irccf:Ontology a owl:Ontology ;
    rdfs:label "Integrated Regulatory Compliance and Cybersecurity Framework Ontology" .

irccf:PlatformProvider a irccf:Stakeholder .

